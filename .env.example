# ==============================================================================
# CONFIGURACIÓN DE SUPABASE - CPI PLATAFORMA DE ESTUDIOS
# ==============================================================================
# 
# Instrucciones de configuración:
# 1. En tu proyecto de Supabase (https://supabase.com/dashboard/project/_):
#    - Ve a Project Settings > API
#    - Copia "Project URL" y pégala en PUBLIC_SUPABASE_URL
#    - Copia "anon public key" y pégala en PUBLIC_SUPABASE_ANON_KEY
# 2. Crea un archivo llamado ".env" en la raíz del proyecto y copia estas líneas con tus datos reales.
# 3. En el SQL Editor de Supabase, ejecuta el archivo "supabase/schema.sql" que ya contiene:
#    - Tablas: alumnos, modulos, calificaciones, sesiones.
#    - Funciones seguras: login_alumno (bcrypt), cambiar_password y carga masiva desde Excel.
# ------------------------------------------------------------------------------

# URL del Proyecto Supabase (ejemplo: https://xyzcompany.supabase.co)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave pública anónima (anon public key)
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# NOTA DE SEGURIDAD:
# Si estas variables se dejan vacías o no se configuran, la plataforma continúa
# funcionando automáticamente en modo de desarrollo local (offline) sin errores.
# ==============================================================================
