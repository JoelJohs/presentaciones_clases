---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getNavigationStructure } from '../utils/navigation';
import { Icon } from 'astro-icon/components';

import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import TableWrapper from '../components/ui/TableWrapper.astro';
import Input from '../components/ui/Input.astro';
import Select from '../components/ui/Select.astro';
import Textarea from '../components/ui/Textarea.astro';
import Badge from '../components/ui/Badge.astro';
import Callout from '../components/ui/Callout.astro';

const lecciones = await getCollection('lecciones');
const nav = getNavigationStructure(lecciones);

const demoSelectOptions = [
  { value: 'g1', label: 'Grupo 1 — Sábado (09:00 - 13:00)' },
  { value: 'g2', label: 'Grupo 2 — Domingo (09:00 - 13:00)' },
  { value: 'lab-a', label: 'Laboratorio de Cómputo A' },
  { value: 'lab-b', label: 'Laboratorio de Cómputo B', disabled: true },
];
---

<Layout title="Sistema de Diseño | CPI" nav={nav} isLesson={false}>
  <div class="space-y-14 pb-20">
    <!-- Encabezado / Hero del Sistema de Diseño -->
    <header class="border-b border-brand-border pb-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-brand-primary/10 text-brand-primary border border-brand-primary/20">
              v2.1 • Componentes Reutilizables
            </span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
              Uso Interno / Docente
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-navy dark:text-white tracking-tight">
            El Manual de Taller Digital
          </h1>
          <p class="text-sm sm:text-base text-brand-muted mt-2 max-w-3xl leading-relaxed">
            Sistema de diseño unificado y biblioteca de componentes reutilizables para la Plataforma de Estudios CPI.
            Garantiza máxima legibilidad en proyección de aula (1080p), espaciado consistente y accesibilidad contrastada WCAG AA.
          </p>
        </div>

        <!-- Barra de estado y saltos rápidos -->
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <a
            href="#tokens"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-border hover:bg-brand-hover-bg text-brand-muted hover:text-brand-text transition-colors"
          >
            Tokens
          </a>
          <a
            href="#tipografia"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-border hover:bg-brand-hover-bg text-brand-muted hover:text-brand-text transition-colors"
          >
            Tipografía
          </a>
          <a
            href="#espaciado"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-border hover:bg-brand-hover-bg text-brand-muted hover:text-brand-text transition-colors"
          >
            Espaciado
          </a>
          <a
            href="#botones"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-border hover:bg-brand-hover-bg text-brand-muted hover:text-brand-text transition-colors"
          >
            Botones
          </a>
          <a
            href="#formularios"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-border hover:bg-brand-hover-bg text-brand-muted hover:text-brand-text transition-colors"
          >
            Formularios
          </a>
          <a
            href="#tarjetas"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-brand-border hover:bg-brand-hover-bg text-brand-muted hover:text-brand-text transition-colors"
          >
            Tarjetas
          </a>
        </div>
      </div>
    </header>

    <!-- 1. TOKENS CROMÁTICOS -->
    <section id="tokens" class="space-y-6 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:palette" class="w-6 h-6 text-brand-primary" />
          1. Paleta de Colores y Superficies
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Colores normativos anclados a la identidad CPI. Ratio de contraste WCAG AA mínimo de 4.5:1.
        </p>
      </div>

      <!-- Cuadrícula de Muestras -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Azul Primario Técnico -->
        <Card variant="elevated" padding="sm" class="space-y-3">
          <div class="h-20 rounded-lg bg-[#0868A8] flex items-center justify-center text-white font-bold text-sm shadow-inner">
            #0868A8
          </div>
          <div>
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-brand-text">Azul Técnico CPI</span>
              <Badge variant="primary" size="sm">Primary</Badge>
            </div>
            <p class="text-xs text-brand-muted mt-1">Botones principales, enlaces, barras de llamada y foco.</p>
            <div class="mt-2 text-xs font-mono text-brand-muted">var(--color-brand-primary)</div>
          </div>
        </Card>

        <!-- Azul Navy Profundo -->
        <Card variant="elevated" padding="sm" class="space-y-3">
          <div class="h-20 rounded-lg bg-[#0E2A44] flex items-center justify-center text-white font-bold text-sm shadow-inner">
            #0E2A44
          </div>
          <div>
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-brand-text">Navy Naval Profundo</span>
              <Badge variant="neutral" size="sm">Sidebar/H1</Badge>
            </div>
            <p class="text-xs text-brand-muted mt-1">Fondo de barra lateral, títulos H1 y contraste estructural.</p>
            <div class="mt-2 text-xs font-mono text-brand-muted">var(--color-brand-navy)</div>
          </div>
        </Card>

        <!-- Ámbar Acento -->
        <Card variant="elevated" padding="sm" class="space-y-3">
          <div class="h-20 rounded-lg bg-[#E8A800] flex items-center justify-center text-slate-900 font-bold text-sm shadow-inner">
            #E8A800 / #F8C808
          </div>
          <div>
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-brand-text">Ámbar Acento</span>
              <Badge variant="accent" size="sm">Accent</Badge>
            </div>
            <p class="text-xs text-brand-muted mt-1">Acentos de marca, badges pendientes y estados de alerta.</p>
            <div class="mt-2 text-xs font-mono text-brand-muted">var(--color-brand-accent)</div>
          </div>
        </Card>

        <!-- Verde Práctico -->
        <Card variant="elevated" padding="sm" class="space-y-3">
          <div class="h-20 rounded-lg bg-[#107C41] flex items-center justify-center text-white font-bold text-sm shadow-inner">
            #107C41
          </div>
          <div>
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-brand-text">Verde Práctico</span>
              <Badge variant="success" size="sm">Success</Badge>
            </div>
            <p class="text-xs text-brand-muted mt-1">Descarga de recursos, retos superados y estados completados.</p>
            <div class="mt-2 text-xs font-mono text-brand-muted">var(--color-success)</div>
          </div>
        </Card>
      </div>

      <!-- Superficies y Capas -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div class="p-4 rounded-xl border border-brand-border bg-brand-bg">
          <div class="font-bold text-xs uppercase tracking-wider text-brand-muted mb-1">Superficie Base</div>
          <div class="font-semibold text-brand-text text-sm">Hielo Azulado (#F3F8FC / #0B1620)</div>
          <p class="text-xs text-brand-muted mt-1">Fondo general para reducir fatiga visual en pantallas.</p>
        </div>
        <div class="p-4 rounded-xl border border-brand-border bg-white dark:bg-[#16283A]">
          <div class="font-bold text-xs uppercase tracking-wider text-brand-muted mb-1">Superficie Elevada</div>
          <div class="font-semibold text-brand-text text-sm">Blanco Puro (#FFFFFF / #16283A)</div>
          <p class="text-xs text-brand-muted mt-1">Tarjetas de contenido, modales y bloques de interactividad.</p>
        </div>
        <div class="p-4 rounded-xl border border-brand-border bg-slate-100 dark:bg-brand-sidebar-bg">
          <div class="font-bold text-xs uppercase tracking-wider text-brand-muted mb-1">Superficie Muted</div>
          <div class="font-semibold text-brand-text text-sm">Gris Frío (#E9F0F7 / #101E2B)</div>
          <p class="text-xs text-brand-muted mt-1">Fondos de toggles, bloques de atajos y paneles secundarios.</p>
        </div>
      </div>
    </section>

    <!-- 2. TIPOGRAFÍA Y ESCALA DUAL -->
    <section id="tipografia" class="space-y-6 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-brand-border pb-3 gap-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
            <Icon name="lucide:type" class="w-6 h-6 text-brand-primary" />
            2. Tipografía y Escala Dual (Monitor vs Proyector)
          </h2>
          <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
            The Dual-Scale Projection Rule: cuerpo de 18px en monitor y 22px obligatorio en proyector de aula.
          </p>
        </div>

        <!-- Conmutador de Escala de Demostración -->
        <div class="inline-flex items-center gap-1.5 p-1 rounded-xl border border-brand-border bg-slate-100 dark:bg-brand-sidebar-bg">
          <button
            id="demo-scale-reading"
            type="button"
            class="px-3 py-1 rounded-lg text-xs font-semibold bg-white dark:bg-brand-bg text-brand-primary shadow-xs transition-all"
          >
            Monitor (18px)
          </button>
          <button
            id="demo-scale-presentation"
            type="button"
            class="px-3 py-1 rounded-lg text-xs font-semibold text-brand-muted hover:text-brand-text transition-all"
          >
            Proyector (22px)
          </button>
        </div>
      </div>

      <!-- Lienzo interactivo de espécimen tipográfico -->
      <div id="typography-specimen-container" class="reading-mode p-6 sm:p-8 rounded-2xl border border-brand-border bg-white dark:bg-[#16283A] transition-all duration-300">
        <div class="prose max-w-none">
          <h1>H1: Hardware y Sistemas Operativos de Computadoras</h1>
          <p class="text-brand-muted text-xs sm:text-sm -mt-3 mb-6">
            Display 800 • 2.50rem (40px) en lectura / 2.875rem (46px) en presentación
          </p>

          <h2>H2: 1. Anatomía de una Unidad Central de Procesamiento</h2>
          <p class="text-brand-muted text-xs sm:text-sm -mt-2 mb-4">
            Headline 700 • 2.00rem (32px) en lectura / 2.25rem (36px) en presentación • Delimita cada diapositiva
          </p>

          <h3>H3: Reto de Exploración: Identificación del Socket y Memoria RAM</h3>
          <p class="text-brand-muted text-xs sm:text-sm -mt-2 mb-4">
            Title 600 • 1.50rem (24px) en lectura / 1.75rem (28px) en presentación • Subsección interna
          </p>

          <p>
            Observa con detenimiento la placa base. Desbloquea la palanca de seguridad del zócalo con firmeza y comprueba
            la orientación de los pines triangulares en la esquina inferior izquierda. Ejecuta el comando <code class="font-mono">dxdiag</code> en la terminal de Windows para verificar la memoria total reconocida por el sistema operativo.
          </p>

          <p class="text-xs text-brand-muted italic border-t border-brand-border pt-4 mt-6">
            Límite óptimo de lectura fijado en un máximo de <strong>75ch</strong> de ancho para proteger la vista durante sesiones largas.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. ESPACIADO CONSISTENTE -->
    <section id="espaciado" class="space-y-6 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:ruler" class="w-6 h-6 text-brand-primary" />
          3. Escala de Espaciado Consistente
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Régimen espacial estricto basado en múltiplos de 4px / 8px para márgenes, padding y separación de elementos.
        </p>
      </div>

      <Card variant="elevated" padding="md" class="space-y-4">
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-1 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">4px (xs)</span>
            <span class="text-xs text-brand-muted">Gaps mínimos, tags</span>
          </div>
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-2 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">8px (sm)</span>
            <span class="text-xs text-brand-muted">Gaps entre botones</span>
          </div>
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-3 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">12px (md-)</span>
            <span class="text-xs text-brand-muted">Padding de inputs</span>
          </div>
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-4 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">16px (md)</span>
            <span class="text-xs text-brand-muted">Padding de tarjetas</span>
          </div>
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-6 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">24px (lg)</span>
            <span class="text-xs text-brand-muted">Separación de bloques</span>
          </div>
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-8 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">32px (xl)</span>
            <span class="text-xs text-brand-muted">Margen entre temas</span>
          </div>
          <div class="p-3 rounded-lg border border-brand-border bg-brand-bg flex flex-col items-center gap-2 text-center">
            <div class="w-12 h-8 bg-brand-primary rounded-xs"></div>
            <span class="text-xs font-mono font-bold text-brand-text">48px (2xl)</span>
            <span class="text-xs text-brand-muted">Salto de secciones</span>
          </div>
        </div>
      </Card>
    </section>

    <!-- 4. BOTONES REUTILIZABLES Y ESTADOS -->
    <section id="botones" class="space-y-6 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:mouse-pointer" class="w-6 h-6 text-brand-primary" />
          4. Componente Button: Variantes y Estados
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Componente <code class="font-mono text-brand-primary">&lt;Button&gt;</code> con soporte nativo de estados (hover, active, focus-visible, disabled) y tamaños.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Variantes -->
        <Card variant="elevated" padding="md" title="Variantes de Estilo">
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary">Primario</Button>
            <Button variant="secondary">Secundario</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="download" icon="lucide:download">Descarga</Button>
            <Button variant="danger">Peligro</Button>
            <Button variant="ghost">Fantasma</Button>
          </div>
          <p class="text-xs text-brand-muted mt-4">
            Cada variante cuenta con elevación de 1px a 2px en hover, foco accesible y retroalimentación táctil en <code class="font-mono">:active</code>.
          </p>
        </Card>

        <!-- Estados y Tamaños -->
        <Card variant="elevated" padding="md" title="Estados (Hover, Focus, Disabled) y Tamaños">
          <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-3">
              <Button size="sm" variant="primary">Pequeño (sm)</Button>
              <Button size="md" variant="primary">Mediano (md)</Button>
              <Button size="lg" variant="primary">Grande (lg)</Button>
            </div>

            <div class="border-t border-brand-border pt-4 flex flex-wrap items-center gap-3">
              <Button variant="primary" disabled>Deshabilitado (disabled)</Button>
              <Button variant="outline" disabled>Outline Deshabilitado</Button>
              <Button variant="primary" icon="lucide:check" iconPosition="right">Con Icono</Button>
            </div>
          </div>
        </Card>
      </div>
    </section>

    <!-- 5. FORMULARIOS Y CONTROLES -->
    <section id="formularios" class="space-y-6 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:check-square" class="w-6 h-6 text-brand-primary" />
          5. Formularios y Controles de Entrada (Input, Select, Textarea)
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Campos de formulario totalmente accesibles (<code class="font-mono">aria-invalid</code>, <code class="font-mono">aria-describedby</code>), con estados de validación, foco y ayuda.
        </p>
      </div>

      <Card variant="elevated" padding="lg">
        <form class="space-y-6 max-w-2xl" onsubmit="return false;">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Input Normal con Icono -->
            <Input
              id="demo-student-name"
              label="Nombre del Estudiante"
              placeholder="Ej. Juan Pérez"
              icon="lucide:user"
              helperText="Nombre completo registrado para constancia."
              required
            />

            <!-- Select -->
            <Select
              id="demo-group-select"
              label="Grupo y Turno"
              options={demoSelectOptions}
              value="g1"
              helperText="Selecciona el horario asignado."
              required
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Input con Estado de Error -->
            <Input
              id="demo-access-code"
              label="Código de Entrega"
              value="ERR-999"
              error="El código ingresado no corresponde a ninguna tarea activa."
              icon="lucide:key"
              required
            />

            <!-- Input Deshabilitado -->
            <Input
              id="demo-system-token"
              label="Identificador de Máquina"
              value="LAB-A-STATION-04"
              disabled
              helperText="Asignado automáticamente por la red de laboratorio."
            />
          </div>

          <!-- Textarea -->
          <Textarea
            id="demo-lesson-feedback"
            label="Bitácora de Observaciones Técnicas"
            placeholder="Describe cualquier anomalía de hardware o comando con error encontrado en el equipo..."
            rows={3}
            helperText="Máximo 300 caracteres."
          />

          <!-- Botones de Acción de Formulario -->
          <div class="flex items-center gap-3 pt-2">
            <Button type="submit" variant="primary" icon="lucide:check">Guardar Registro</Button>
            <Button type="reset" variant="outline">Limpiar Campos</Button>
          </div>
        </form>
      </Card>
    </section>

    <!-- 6. TARJETAS Y CONTENEDORES MODULARES -->
    <section id="tarjetas" class="space-y-6 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:layout" class="w-6 h-6 text-brand-primary" />
          6. Tarjetas y Bloques Prácticos (&lt;Card&gt;)
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Contenedores modulares reutilizables con variantes para contenido elevated, interactivo con hover lift, retos y descargas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Tarjeta Elevada Estándar -->
        <Card variant="elevated" padding="md" title="Card Elevada">
          <p class="text-xs text-brand-muted leading-relaxed">
            Fondo blanco (#FFFFFF) en modo claro y fondo navy (#16283A) en oscuro, delimitado por un borde sutil de 1px.
          </p>
        </Card>

        <!-- Tarjeta Interactiva con Hover Lift -->
        <Card variant="interactive" padding="md" title="Card Interactiva (Hover)">
          <p class="text-xs text-brand-muted leading-relaxed">
            Cuenta con micro-elevación <code class="font-mono text-brand-primary">translateY(-2px)</code> y sombra de enfoque para lecciones o enlaces navegables.
          </p>
        </Card>

        <!-- Tarjeta Outline -->
        <Card variant="outline" padding="md" title="Card Outline">
          <p class="text-xs text-brand-muted leading-relaxed">
            Fondo transparente con borde perimetral nítido, ideal para áreas de bajo énfasis o datos secundarios.
          </p>
        </Card>
      </div>

      <!-- Tarjetas Prácticas de Lección -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-2">
        <!-- Challenge Card (Reto Práctico / Modo Ninja) -->
        <Card variant="challenge" class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-xs font-extrabold uppercase tracking-wider bg-teal-500/20 text-teal-800 dark:text-teal-300">
                Reto en Vivo
              </span>
              <h4 class="font-bold text-brand-navy dark:text-white text-base">Modo Ninja: Atajos de Windows</h4>
            </div>
            <span class="text-xs font-mono text-teal-700 dark:text-teal-400 font-bold">100% Práctico</span>
          </div>
          <p class="text-xs sm:text-sm text-brand-muted">
            Presiona <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 font-mono text-xs">Win + R</kbd>, digita <code class="font-mono text-teal-600 dark:text-teal-400">perfmon /res</code> y comprueba qué proceso consume mayor tiempo de procesador en tu máquina.
          </p>
        </Card>

        <!-- Download Card -->
        <div class="download-card my-0!">
          <div class="download-card__content">
            <div class="download-card__icon">
              <Icon name="lucide:download" class="w-7 h-7" />
            </div>
            <div class="download-card__body">
              <div class="download-card__badges">
                <span class="download-card__tag">Archivo de Práctica</span>
                <span class="download-card__meta font-mono">XLSX • 45 KB</span>
              </div>
              <h4 class="download-card__title">Plantilla de Inventario de Componentes</h4>
              <p class="download-card__desc">Hoja estructurada para registrar número de serie y especificaciones.</p>
            </div>
          </div>
          <Button variant="download" href="#descargar">Descargar</Button>
        </div>
      </div>
    </section>

    <!-- 7. TABLAS SEMÁNTICAS HTML -->
    <section class="space-y-6">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:table" class="w-6 h-6 text-brand-primary" />
          7. Tablas Semánticas HTML (&lt;TableWrapper&gt;)
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Prohibido el uso de tablas Markdown de barras pipes (<code class="font-mono">|---|</code>). Toda tabla debe ser semántica HTML estándar.
        </p>
      </div>

      <TableWrapper caption="Especificaciones de Microprocesadores en Laboratorio">
        <div class="prose max-w-none">
          <table>
            <thead>
              <tr>
                <th>Componente</th>
                <th>Función Primaria</th>
                <th>Parámetro Crítico</th>
                <th>Estado de Evaluación</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>CPU (Microprocesador)</strong></td>
                <td>Ejecuta el ciclo Fetch-Decode-Execute de instrucciones.</td>
                <td>Frecuencia en GHz y Socket compatible.</td>
                <td><Badge variant="success">Demostrado</Badge></td>
              </tr>
              <tr>
                <td><strong>Memoria RAM</strong></td>
                <td>Almacenamiento volátil de trabajo ultrarrápido.</td>
                <td>Capacidad (GB) y canal dual (DDR4/DDR5).</td>
                <td><Badge variant="success">Demostrado</Badge></td>
              </tr>
              <tr>
                <td><strong>Unidad NVMe M.2</strong></td>
                <td>Persistencia rápida del sistema operativo.</td>
                <td>Lectura secuencial (MB/s) en PCIe 4.0.</td>
                <td><Badge variant="warning">Pendiente</Badge></td>
              </tr>
            </tbody>
          </table>
        </div>
      </TableWrapper>
    </section>

    <!-- 8. NOTAS Y LLAMADAS EDITORIALES (<Callout>) -->
    <section class="space-y-6">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:message-square-quote" class="w-6 h-6 text-brand-primary" />
          8. Avisos y Llamadas Editoriales (&lt;Callout&gt;)
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Separadores visuales para notas, precauciones de taller, consejos técnicos y demostraciones.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Callout type="info" title="Nota de Aprendizaje">
          Cada concepto teórico debe estar respaldado por un ejercicio verificable en la máquina. La teoría sin comprobación práctica no se fija.
        </Callout>

        <Callout type="warning" title="Precaución en Taller">
          Nunca abras una fuente de poder para limpiarla; los condensadores internos retienen carga letal incluso desconectados de la corriente.
        </Callout>

        <Callout type="tip" title="Consejo Práctico">
          Utiliza la combinación <kbd class="px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-800 font-mono text-xs">Ctrl + Shift + Esc</kbd> para abrir de forma instantánea el Administrador de Tareas.
        </Callout>

        <Callout type="result" title="Resultado Esperado">
          La luz LED de la tarjeta de red debe parpadear en verde ámbar indicando enlace Gigabit Ethernet establecido con el conmutador.
        </Callout>
      </div>
    </section>

    <!-- 9. REGLAS MANDATORIAS (DO'S AND DON'TS) -->
    <section class="space-y-6">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-text flex items-center gap-2">
          <Icon name="lucide:shield-check" class="w-6 h-6 text-brand-primary" />
          9. Criterios Mandatorios de Calidad (Do's & Don'ts)
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Reglas arquitectónicas inviolables para redactores y agentes en esta plataforma.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- DO'S -->
        <div class="p-6 rounded-2xl border border-emerald-500/20 bg-emerald-500/5 space-y-3">
          <div class="font-bold text-emerald-800 dark:text-emerald-300 text-sm flex items-center gap-2">
            <Icon name="lucide:check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            Lo que DEBES hacer siempre:
          </div>
          <ul class="text-xs sm:text-sm space-y-2 text-brand-text">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">•</span>
              <span><strong>Tablas estrictamente en HTML:</strong> usar etiquetas <code class="font-mono">&lt;table&gt;</code> estándar o el componente <code class="font-mono">&lt;TableWrapper&gt;</code>.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">•</span>
              <span><strong>Redacción en 2ª persona imperativo:</strong> dirigirse al alumno con verbos de acción ("Observa", "Prueba", "Crea", "Comprueba").</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">•</span>
              <span><strong>Separador de diapositivas:</strong> usar encabezado <code class="font-mono">##</code> seguido de separador <code class="font-mono">---</code>.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">•</span>
              <span><strong>Contraste mínimo WCAG AA:</strong> ratio mínimo de 4.5:1 en todos los textos sobre fondos claros y oscuros.</span>
            </li>
          </ul>
        </div>

        <!-- DON'TS -->
        <div class="p-6 rounded-2xl border border-rose-500/20 bg-rose-500/5 space-y-3">
          <div class="font-bold text-rose-800 dark:text-rose-300 text-sm flex items-center gap-2">
            <Icon name="lucide:alert-circle" class="w-5 h-5 text-rose-600 dark:text-rose-400" />
            Lo que está TERMINANTEMENTE PROHIBIDO:
          </div>
          <ul class="text-xs sm:text-sm space-y-2 text-brand-text">
            <li class="flex items-start gap-2">
              <span class="text-rose-600 font-bold">•</span>
              <span><strong>Tablas Markdown de barras pipes:</strong> nunca usar sintaxis <code class="font-mono">| a | b |</code> en lecciones MDX.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-600 font-bold">•</span>
              <span><strong>Notas para el docente:</strong> prohibido incluir frases como "explica al grupo", "agenda de la sesión" o "muestra en pantalla".</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-600 font-bold">•</span>
              <span><strong>Ponderación de asistencia:</strong> la asistencia NO se califica (0% de validez numérica). La evaluación es 100% técnica demostrable.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose-600 font-bold">•</span>
              <span><strong>Gamificación ruidosa:</strong> sin confeti, sonidos distractores ni elementos infantiles fuera del tono técnico formal.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <!-- Script interactivo del Showroom -->
  <script is:inline>
    const btnReading = document.getElementById('demo-scale-reading');
    const btnPresentation = document.getElementById('demo-scale-presentation');
    const specimenContainer = document.getElementById('typography-specimen-container');

    if (btnReading && btnPresentation && specimenContainer) {
      btnReading.addEventListener('click', () => {
        specimenContainer.classList.remove('presentation-mode');
        specimenContainer.classList.add('reading-mode');
        btnReading.classList.add('bg-white', 'dark:bg-brand-bg', 'text-brand-primary', 'shadow-xs');
        btnReading.classList.remove('text-brand-muted');
        btnPresentation.classList.remove('bg-white', 'dark:bg-brand-bg', 'text-brand-primary', 'shadow-xs');
        btnPresentation.classList.add('text-brand-muted');
      });

      btnPresentation.addEventListener('click', () => {
        specimenContainer.classList.remove('reading-mode');
        specimenContainer.classList.add('presentation-mode');
        btnPresentation.classList.add('bg-white', 'dark:bg-brand-bg', 'text-brand-primary', 'shadow-xs');
        btnPresentation.classList.remove('text-brand-muted');
        btnReading.classList.remove('bg-white', 'dark:bg-brand-bg', 'text-brand-primary', 'shadow-xs');
        btnReading.classList.add('text-brand-muted');
      });
    }
  </script>
</Layout>
