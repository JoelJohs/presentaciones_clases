---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getNavigationStructure } from '../utils/navigation';
import { findLessonBySlug } from '../config/curriculum';
import LessonCompletionBar from '../components/interactive/LessonCompletionBar.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const lecciones = await getCollection('lecciones');
  const nav = getNavigationStructure(lecciones);

  return nav.allLessonsOrdered.map((lessonLink) => {
    const leccion = lecciones.find(l => l.id === lessonLink.id)!;
    return {
      params: { slug: lessonLink.slug },
      props: { leccion, lecciones, nav },
    };
  });
}

const { leccion, lecciones, nav: propsNav } = Astro.props;
const { Content } = await render(leccion);

const nav = propsNav || getNavigationStructure(lecciones);
const activeSlug = leccion.id.replace(/\.(mdx|md)$/, '').replace(/\/index$/, '');
const currentIndex = nav.allLessonsOrdered.findIndex(l => l.slug === activeSlug);

const prevLesson = currentIndex > 0 ? nav.allLessonsOrdered[currentIndex - 1] : null;
const nextLesson = currentIndex < nav.allLessonsOrdered.length - 1 ? nav.allLessonsOrdered[currentIndex + 1] : null;

const meta = findLessonBySlug(activeSlug);
const isInduction = activeSlug === '00-inicio' || activeSlug.startsWith('00-');
const duration = leccion.data.duration || meta?.duration || 45;
const kind = leccion.data.kind || meta?.kind || 'lesson';
const objectives = leccion.data.objectives || [];
const leccionSemana = leccion.data.semana || 0;
---

<Layout title={leccion.data.title} nav={nav} activeSlug={activeSlug} isLesson={true}>
  <div class="space-y-6">
    <!-- Migas de pan y metadatos de lección -->
    <header class="border-b border-brand-border pb-6 space-y-3">
      <nav aria-label="Ruta de navegación" class="flex items-center gap-1.5 text-xs text-brand-muted flex-wrap">
        <a href="/" class="hover:text-brand-text transition-colors">Inicio</a>
        {leccion.data.moduleTitle && (
          <>
            <Icon name="lucide:chevron-right" class="h-3 w-3" />
            <span class="font-medium text-brand-primary">{leccion.data.moduleTitle}</span>
          </>
        )}
        {leccion.data.topicTitle && (
          <>
            <Icon name="lucide:chevron-right" class="h-3 w-3" />
            <span class="truncate max-w-[200px]">{leccion.data.topicTitle}</span>
          </>
        )}
      </nav>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
        {leccion.data.title}
      </h1>

      <!-- Etiquetas informativas -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        {isInduction ? (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-purple-50 dark:bg-purple-950/40 border border-purple-300 dark:border-purple-800 text-purple-700 dark:text-purple-300 font-semibold shadow-xs">
            <Icon name="lucide:presentation" class="h-3.5 w-3.5" />
            <span>Presentación Oficial del Curso</span>
          </span>
        ) : (
          <>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white dark:bg-brand-sidebar-bg border border-brand-border text-brand-text font-medium shadow-xs">
              <Icon name="lucide:clock" class="h-3.5 w-3.5 text-brand-primary" />
              <span>{duration} min</span>
            </span>

            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-brand-primary/10 border border-brand-primary/20 text-brand-primary font-semibold">
              <Icon name="lucide:book-open" class="h-3.5 w-3.5" />
              <span class="capitalize">{kind}</span>
            </span>
          </>
        )}

        {leccion.data.fecha && (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white dark:bg-brand-sidebar-bg border border-brand-border text-brand-text font-mono shadow-xs">
            <Icon name="lucide:calendar" class="h-3.5 w-3.5 text-brand-primary" />
            <span>{leccion.data.fecha}</span>
          </span>
        )}
      </div>

      <!-- Objetivos pedagógicos -->
      {objectives.length > 0 && (
        <div class="mt-4 p-4 rounded-xl border border-brand-border bg-brand-callout-bg text-xs space-y-2">
          <span class="font-bold text-brand-text uppercase tracking-wider block">Objetivos de la sesión</span>
          <ul class="list-disc list-inside space-y-1.5 text-brand-text/90 marker:text-brand-primary">
            {objectives.map((obj: string) => (
              <li>{obj}</li>
            ))}
          </ul>
        </div>
      )}
    </header>

    <!-- Guard de bloqueo para alumnos si la lección es futura -->
    <div
      id="lesson-locked-guard"
      class="hidden rounded-2xl border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/40 p-6 sm:p-8 text-center space-y-4 shadow-xs"
    >
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200">
        <Icon name="lucide:lock" class="h-6 w-6" />
      </div>
      <div class="space-y-1">
        <h2 class="text-lg font-bold text-amber-950 dark:text-amber-200">
          Clase no disponible para tu grupo
        </h2>
        <p id="lesson-guard-message" class="text-xs sm:text-sm text-amber-800 dark:text-amber-300 max-w-md mx-auto leading-relaxed">
          Esta lección corresponde a una semana posterior del curso. Se habilitará cuando tu grupo alcance esta semana.
        </p>
      </div>
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-primary hover:bg-brand-accent text-white text-xs font-semibold transition-colors shadow-xs"
        >
          <Icon name="lucide:arrow-left" class="h-4 w-4" />
          <span>Volver a mi clase activa</span>
        </a>
      </div>
    </div>

    <!-- Contenido de la Lección en MDX -->
    <article class="prose max-w-none" data-lesson-content data-slug={activeSlug} data-lesson-week={leccionSemana}>
      <Content />
    </article>

    <!-- Barra de Completar Lección (Solo para lecciones regulares de alumnos) -->
    {!isInduction && (
      <LessonCompletionBar
        slug={activeSlug}
        nextLesson={nextLesson ? { slug: nextLesson.slug, title: nextLesson.title } : null}
      />
    )}

    <!-- Navegación al pie de página -->
    {!isInduction ? (
      <nav class="flex items-center justify-between gap-4 border-t border-brand-border pt-6 text-xs">
        {prevLesson ? (
          <a
            href={`/${prevLesson.slug}`}
            class="flex items-center gap-2 px-3 py-2 rounded-lg border border-brand-border text-brand-text hover:bg-brand-callout-bg dark:hover:bg-brand-sidebar-bg transition-colors"
          >
            <Icon name="lucide:arrow-left" class="h-4 w-4" />
            <span>{prevLesson.title}</span>
          </a>
        ) : <span />}

        {nextLesson ? (
          <a
            href={`/${nextLesson.slug}`}
            class="flex items-center gap-2 px-3 py-2 rounded-lg bg-brand-primary text-white font-medium hover:bg-brand-accent transition-colors"
          >
            <span>{nextLesson.title}</span>
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
        ) : <span />}
      </nav>
    ) : (
      <nav class="flex items-center justify-between gap-4 border-t border-brand-border pt-6 text-xs flex-wrap">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-brand-border text-brand-text hover:bg-brand-callout-bg dark:hover:bg-brand-sidebar-bg font-semibold transition-colors"
        >
          <Icon name="lucide:arrow-left" class="h-4 w-4" />
          <span>Volver al Inicio</span>
        </a>
        <a
          href="/plan-de-estudios"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-primary hover:bg-brand-accent text-white font-semibold transition-colors shadow-xs"
        >
          <Icon name="lucide:map" class="h-4 w-4" />
          <span>Consultar Plan de Estudios Completo</span>
        </a>
      </nav>
    )}
  </div>

  <!-- Inicializador de Diapositivas y Envoltorios de Tablas -->
  <script>
    import { presentationStore } from '../features/presentation';
    import { getCurrentUser, getPortalDB } from '../features/portal/db';

    function checkWeekAccess() {
      const user = getCurrentUser();
      const db = getPortalDB();
      const article = document.querySelector<HTMLElement>('article[data-lesson-content]');
      const guard = document.getElementById('lesson-locked-guard');
      const completionBar = document.querySelector<HTMLElement>('[data-lesson-completion-bar]');
      if (!article || !guard) return;

      const weekAttr = article.getAttribute('data-lesson-week');
      const lessonWeek = weekAttr ? parseInt(weekAttr, 10) : 0;

      if (lessonWeek > 0 && user && user.rol === 'alumno') {
        const groupKey = (user.clase || user.grupo || 'sabado') as 'sabado' | 'domingo';
        const groupWeek = db.grupos[groupKey]?.semanaActual || 1;
        if (lessonWeek > groupWeek) {
          article.classList.add('hidden');
          guard.classList.remove('hidden');
          if (completionBar) completionBar.classList.add('hidden');
          const msg = document.getElementById('lesson-guard-message');
          if (msg) {
            msg.textContent = `Esta clase corresponde a la Semana ${lessonWeek}. Tu grupo (${groupKey === 'sabado' ? 'Clase Sábado' : 'Clase Domingo'}) está actualmente en la Semana ${groupWeek}. El acceso se activará en la fecha programada.`;
          }
          return;
        }
      }
      article.classList.remove('hidden');
      guard.classList.add('hidden');
      if (completionBar) completionBar.classList.remove('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
      checkWeekAccess();
      window.addEventListener('cpi-portal-update', checkWeekAccess);

      const article = document.querySelector<HTMLElement>('article.prose[data-lesson-content]');
      if (!article) return;

      // Envolver tablas para scroll responsivo con indicador final
      const tables = article.querySelectorAll('table');
      tables.forEach((table) => {
        if (!table.parentElement?.classList.contains('prose-table-wrapper')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'prose-table-wrapper';
          table.parentNode?.insertBefore(wrapper, table);
          wrapper.appendChild(table);

          const updateTableScrollHint = () => {
            wrapper.classList.toggle(
              'is-at-end',
              wrapper.scrollLeft + wrapper.clientWidth >= wrapper.scrollWidth - 1,
            );
          };
          wrapper.addEventListener('scroll', updateTableScrollHint, { passive: true });
          updateTableScrollHint();
        }
      });

      // Inicializar el store de presentación
      const slug = article.getAttribute('data-slug') || '';
      presentationStore.init(slug, article);
    });
  </script>
</Layout>
