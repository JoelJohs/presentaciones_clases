---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getNavigationStructure } from '../utils/navigation';
import { Icon } from 'astro-icon/components';

import { getTodasLasSemanas } from '../data/plan-estudios';

const lecciones = await getCollection('lecciones');
const nav = getNavigationStructure(lecciones);
const todasLasSemanas = getTodasLasSemanas();

const leccionesData = lecciones
  .filter(l => l.data.published !== false)
  .map(l => ({
    slug: l.id.replace(/\.(mdx|md)$/, '').replace(/\/index$/, ''),
    title: l.data.title,
    semana: l.data.semana || 0,
    moduleTitle: l.data.moduleTitle || '',
  }));
---

<Layout title="Panel del Docente" nav={nav} isLesson={false}>
  <div class="space-y-6">
    <!-- Encabezado de Página -->
    <header class="border-b border-brand-border pb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <nav aria-label="Ruta" class="flex items-center gap-1.5 text-xs text-brand-muted mb-2">
          <a href="/" class="hover:text-brand-text">Inicio</a>
          <Icon name="lucide:chevron-right" class="h-3 w-3" />
          <span class="text-brand-primary font-medium">Panel del Docente</span>
        </nav>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-brand-text">
          Control Académico y Grupos
        </h1>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">
          Gestión de avance semanal por grupo, sincronización BaaS y respaldos
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <a
          href="/00-inicio"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-brand-border bg-brand-callout-bg dark:bg-brand-sidebar-bg hover:border-brand-primary text-brand-text text-xs font-semibold transition-colors shadow-xs"
          title="Diapositivas para proyectar e inducir a nuevos grupos"
        >
          <Icon name="lucide:presentation" class="h-3.5 w-3.5 text-brand-primary" />
          <span>Presentación Inducción</span>
        </a>
        <a
          href="/plan-de-estudios"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-brand-border bg-brand-callout-bg hover:border-brand-primary text-brand-text text-xs font-semibold transition-colors"
        >
          <Icon name="lucide:map" class="h-3.5 w-3.5 text-brand-primary" />
          <span>Plan de Estudios</span>
        </a>
        <span id="panel-role-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
          <Icon name="lucide:check-circle-2" class="h-3.5 w-3.5" />
          <span id="panel-role-text">Modo Docente Habilitado</span>
        </span>
      </div>
    </header>

    <!-- Estado Restringido si no es docente -->
    <div id="panel-unauthorized" class="max-w-md mx-auto py-12 text-center space-y-4 hidden">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400">
        <Icon name="lucide:shield-alert" class="h-6 w-6" />
      </div>
      <h2 class="text-lg font-bold text-brand-text">Acceso Exclusivo para Docentes</h2>
      <p class="text-xs sm:text-sm text-brand-muted">
        Esta sección requiere permisos de docente. Inicia sesión con tus credenciales de profesor para acceder a la gestión de grupos.
      </p>
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-accent text-white font-semibold text-xs transition-colors shadow-xs"
        >
          <Icon name="lucide:arrow-left" class="h-4 w-4" />
          <span>Volver al inicio</span>
        </a>
      </div>
    </div>

    <!-- Contenido del Panel Docente -->
    <div id="panel-content" class="space-y-6">
      <!-- Control de Grupos y Semanas -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Clase Sábado -->
        <div class="p-5 rounded-2xl border border-brand-border bg-white dark:bg-brand-sidebar-bg space-y-4 shadow-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-amber-500"></span>
              <h2 class="text-sm font-bold text-brand-text">Clase Sábado</h2>
            </div>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-brand-border/60 text-brand-text">09:00 – 13:00 h (4 hrs)</span>
          </div>

          <p class="text-xs text-brand-muted">
            Define la semana en curso de tu grupo de sábado. Los alumnos solo ven el contenido desbloqueado hasta esta semana.
          </p>

          <div class="flex items-center gap-2 pt-2 flex-wrap">
            <label for="week-sabado" class="text-xs font-semibold text-brand-text">Semana:</label>
            <input
              id="week-sabado"
              type="number"
              min="1"
              max="54"
              value="4"
              class="w-16 px-2.5 py-1 text-center font-mono font-bold text-xs rounded-lg border border-brand-border bg-brand-bg text-brand-text outline-none focus:border-brand-primary"
            />
            <span class="text-xs text-brand-muted font-mono">/ 54</span>
            <button
              type="button"
              id="btn-save-sabado"
              class="px-3 py-1 rounded-lg border border-brand-border bg-brand-callout-bg hover:border-brand-primary text-brand-text text-xs font-semibold transition-colors"
            >
              Fijar
            </button>
            <button
              type="button"
              id="btn-advance-sabado"
              class="px-3 py-1 rounded-lg bg-brand-primary text-white text-xs font-semibold hover:bg-brand-accent transition-colors inline-flex items-center gap-1"
            >
              <span>+1 Finalizar semana</span>
            </button>
            <span id="feedback-sabado" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hidden"></span>
          </div>

          <!-- Vista de Lección para Sábado -->
          <div id="panel-sabado-lesson-details" class="pt-3 border-t border-brand-border space-y-2"></div>
        </div>

        <!-- Clase Domingo -->
        <div class="p-5 rounded-2xl border border-brand-border bg-white dark:bg-brand-sidebar-bg space-y-4 shadow-xs">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-emerald-500"></span>
              <h2 class="text-sm font-bold text-brand-text">Clase Domingo</h2>
            </div>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-brand-border/60 text-brand-text">09:00 – 13:00 h (4 hrs)</span>
          </div>

          <p class="text-xs text-brand-muted">
            Define la semana en curso de tu grupo de domingo. Se administra de forma independiente para respetar el ritmo de cada clase.
          </p>

          <div class="flex items-center gap-2 pt-2 flex-wrap">
            <label for="week-domingo" class="text-xs font-semibold text-brand-text">Semana:</label>
            <input
              id="week-domingo"
              type="number"
              min="1"
              max="54"
              value="1"
              class="w-16 px-2.5 py-1 text-center font-mono font-bold text-xs rounded-lg border border-brand-border bg-brand-bg text-brand-text outline-none focus:border-brand-primary"
            />
            <span class="text-xs text-brand-muted font-mono">/ 54</span>
            <button
              type="button"
              id="btn-save-domingo"
              class="px-3 py-1 rounded-lg border border-brand-border bg-brand-callout-bg hover:border-brand-primary text-brand-text text-xs font-semibold transition-colors"
            >
              Fijar
            </button>
            <button
              type="button"
              id="btn-advance-domingo"
              class="px-3 py-1 rounded-lg bg-brand-primary text-white text-xs font-semibold hover:bg-brand-accent transition-colors inline-flex items-center gap-1"
            >
              <span>+1 Finalizar semana</span>
            </button>
            <span id="feedback-domingo" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hidden"></span>
          </div>

          <!-- Vista de Lección para Domingo -->
          <div id="panel-domingo-lesson-details" class="pt-3 border-t border-brand-border space-y-2"></div>
        </div>
      </div>

      <!-- Proyector Directo de Clases para Docente -->
      <div class="p-5 sm:p-6 rounded-2xl border border-purple-500/30 bg-white dark:bg-brand-sidebar-bg space-y-4 shadow-xs">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
              <Icon name="lucide:presentation" class="h-4 w-4" />
            </div>
            <div>
              <h2 class="text-sm font-bold text-brand-text">Proyector Directo de Clases para Docente</h2>
              <p class="text-xs text-brand-muted">Proyecta directamente cualquier lección disponible en el aula sin alterar el avance de los grupos.</p>
            </div>
          </div>
          <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-lg bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
            Acceso Docente
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
          <div class="flex-1">
            <label for="select-quick-project-lesson" class="sr-only">Seleccionar clase para proyectar</label>
            <select
              id="select-quick-project-lesson"
              class="w-full px-3.5 py-2.5 rounded-xl border border-brand-border bg-white dark:bg-brand-bg text-xs font-medium text-brand-text outline-none focus:border-brand-primary"
            >
              <!-- Llenado dinámicamente -->
            </select>
          </div>
          <button
            type="button"
            id="btn-quick-project-go"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-semibold text-xs transition-colors shadow-xs shrink-0 cursor-pointer"
          >
            <Icon name="lucide:presentation" class="h-4 w-4" />
            <span>Proyectar en pantalla de aula</span>
            <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
          </button>
        </div>
      </div>

      <!-- Directorio de Alumnos y Credenciales de Acceso -->
      <div class="p-6 rounded-2xl border border-brand-border bg-white dark:bg-brand-sidebar-bg space-y-4 shadow-xs">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center">
              <Icon name="lucide:users" class="h-4 w-4" />
            </div>
            <div>
              <h2 class="text-sm font-bold text-brand-text">Directorio de Alumnos y Credenciales</h2>
              <p class="text-xs text-brand-muted">Consulta el nombre de usuario y contraseña provisional para cada alumno</p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs text-brand-muted">Contraseña inicial:</span>
            <code class="px-2.5 py-0.5 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono font-bold text-xs border border-amber-500/20">sabcpi</code>
          </div>
        </div>

        <div class="rounded-xl border border-brand-border overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left">
              <thead class="bg-brand-callout-bg/70 border-b border-brand-border text-brand-muted uppercase font-bold text-[10px] tracking-wider">
                <tr>
                  <th class="py-2.5 px-3">Estudiante</th>
                  <th class="py-2.5 px-3">Usuario (Login)</th>
                  <th class="py-2.5 px-3 text-center">Clave / Matrícula</th>
                  <th class="py-2.5 px-3 text-center">Clase</th>
                  <th class="py-2.5 px-3 text-right">Copiar</th>
                </tr>
              </thead>
              <tbody id="panel-students-tbody" class="divide-y divide-brand-border">
                <!-- Se llena dinámicamente con JavaScript -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Gestión de Datos y BaaS (Supabase Ready) -->
      <div class="p-6 rounded-2xl border border-brand-border bg-white dark:bg-brand-sidebar-bg space-y-4 shadow-xs">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div class="flex items-center gap-2.5">
            <div class="h-8 w-8 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center">
              <Icon name="lucide:database" class="h-4 w-4" />
            </div>
            <div>
              <h2 class="text-sm font-bold text-brand-text">Capa de Datos y Migración BaaS</h2>
              <p class="text-xs text-brand-muted">Exporta e importa estados sin perder calificaciones ni configuraciones</p>
            </div>
          </div>

          <span id="supabase-status-pill" class="text-xs font-semibold px-2.5 py-1 rounded-full border border-brand-border bg-brand-bg text-brand-muted">
            Verificando Supabase...
          </span>
        </div>

        <div class="flex flex-wrap gap-2.5 pt-2">
          <button
            type="button"
            id="btn-export-json"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-brand-border bg-white dark:bg-brand-sidebar-bg hover:border-brand-primary text-xs font-semibold text-brand-text transition-all"
          >
            <Icon name="lucide:download" class="h-3.5 w-3.5 text-brand-primary" />
            <span>Exportar Respaldo (.json)</span>
          </button>

          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-brand-border bg-white dark:bg-brand-sidebar-bg hover:border-brand-primary text-xs font-semibold text-brand-text transition-all cursor-pointer">
            <Icon name="lucide:upload" class="h-3.5 w-3.5 text-amber-500" />
            <span>Importar Respaldo</span>
            <input type="file" id="input-import-json" accept="application/json" class="hidden" />
          </label>

          <button
            type="button"
            id="btn-reset-data"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 text-xs font-semibold hover:bg-rose-100 transition-all ml-auto"
          >
            <Icon name="lucide:rotate-ccw" class="h-3.5 w-3.5" />
            <span>Restablecer Semilla</span>
          </button>
        </div>

        <div class="mt-4 p-3.5 rounded-xl border border-brand-border bg-brand-callout-bg/60 text-xs text-brand-muted space-y-1">
          <span class="font-bold text-brand-text block">Conexión con Supabase:</span>
          <p>Para sincronización automática en la nube, define <code class="font-mono text-brand-primary">PUBLIC_SUPABASE_URL</code> y <code class="font-mono text-brand-primary">PUBLIC_SUPABASE_ANON_KEY</code> en tu archivo <code class="font-mono">.env</code>. Si están ausentes, la plataforma opera automáticamente en almacenamiento local persistente.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Datos del Plan de Estudio y Lecciones para el cliente -->
  <script is:inline id="panel-semanas-json" type="application/json" set:html={JSON.stringify(todasLasSemanas)}></script>
  <script is:inline id="panel-lecciones-json" type="application/json" set:html={JSON.stringify(leccionesData)}></script>
</Layout>

<script>
  import { getPortalDB, getCurrentUser, updateWeek, exportDB, importDB, savePortalDB, SEED_PORTAL_DB, syncRemoteGroups } from '../features/portal/db';
  import { isSupabaseConfigured, fetchStudentsFromSupabase } from '../lib/supabase';
  import { escapeHtml } from '../utils/security';

  let isSyncingStudents = false;

  const semanasDataEl = document.getElementById('panel-semanas-json');
  const leccionesDataEl = document.getElementById('panel-lecciones-json');
  const allSemanas = semanasDataEl ? JSON.parse(semanasDataEl.textContent || '[]') : [];
  const allLecciones = leccionesDataEl ? JSON.parse(leccionesDataEl.textContent || '[]') : [];

  function getBadgeConfig(tipo: string): { bg: string; text: string; label: string } {
    switch (tipo) {
      case 'laboratorio':
        return { bg: 'bg-sky-50 dark:bg-sky-950/50 border border-sky-200 dark:border-sky-800', text: 'text-sky-800 dark:text-sky-300', label: 'Laboratorio' };
      case 'proyecto':
        return { bg: 'bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-800', text: 'text-indigo-800 dark:text-indigo-300', label: 'Proyecto' };
      case 'evaluacion':
        return { bg: 'bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800', text: 'text-rose-800 dark:text-rose-300', label: 'Evaluación' };
      default:
        return { bg: 'bg-amber-50 dark:bg-amber-950/50 border border-amber-200 dark:border-amber-800', text: 'text-amber-800 dark:text-amber-300', label: 'Práctica de Aula' };
    }
  }

  function renderGroupLessonPreview(containerId: string, weekNum: number) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const sem = allSemanas.find((s: any) => s.semana === weekNum) || allSemanas[0];
    if (!sem) return;
    const matchLesson = allLecciones.find((l: any) => l.semana === sem.semana);
    const b = getBadgeConfig(sem.claseTipo);

    container.innerHTML = `
      <div class="space-y-1.5">
        <div class="flex items-center justify-between gap-2 flex-wrap text-xs">
          <span class="font-mono font-semibold text-brand-muted text-[11px]">
            Módulo ${escapeHtml(sem.moduloNumeroStr)}: ${escapeHtml(sem.moduloTitulo)}
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold ${b.bg} ${b.text}">
            ${escapeHtml(b.label)}
          </span>
        </div>
        <h5 class="text-sm font-bold text-brand-text leading-snug">
          Semana ${sem.semana}: ${escapeHtml(sem.claseTitulo)}
        </h5>
        <p class="text-xs text-brand-muted line-clamp-2 leading-relaxed">
          ${escapeHtml(sem.claseDescripcion)}
        </p>
      </div>

      <div class="pt-2 flex items-center justify-between gap-2 flex-wrap">
        ${matchLesson ? `
          <a
            href="/${matchLesson.slug}?mode=slides"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-brand-primary hover:bg-brand-accent text-white font-semibold text-xs transition-colors shadow-xs"
            title="Abrir presentación de clase para proyectar en aula"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
            </svg>
            <span>Proyectar clase activa en aula</span>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
            </svg>
          </a>
        ` : `
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-brand-callout-bg border border-brand-border text-xs text-brand-muted font-medium">
            <svg class="h-4 w-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Sesión práctica en aula de cómputo</span>
          </span>
        `}
      </div>
    `;
  }

  function initQuickProjectDropdown() {
    const selectQuick = document.getElementById('select-quick-project-lesson') as HTMLSelectElement | null;
    if (selectQuick && allLecciones.length > 0 && selectQuick.children.length === 0) {
      const sorted = [...allLecciones].sort((a: any, b: any) => (a.semana || 0) - (b.semana || 0));
      selectQuick.innerHTML = sorted.map((l: any) => `
        <option value="${l.slug}">
          Semana ${l.semana || '—'}: ${escapeHtml(l.title)}
        </option>
      `).join('');
    }
  }

  function showFeedback(id: string, message: string) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
    setTimeout(() => {
      el.classList.add('hidden');
    }, 3000);
  }

  function initPanel(skipInputSync = false) {
    const user = getCurrentUser();
    const isTeacher = user?.rol === 'profesor';

    const panelUnauthorized = document.getElementById('panel-unauthorized');
    const panelContent = document.getElementById('panel-content');
    const roleBadge = document.getElementById('panel-role-badge');
    const roleText = document.getElementById('panel-role-text');
    const supabasePill = document.getElementById('supabase-status-pill');

    if (supabasePill) {
      if (isSupabaseConfigured()) {
        supabasePill.textContent = 'Supabase Conectado';
        supabasePill.className = 'text-xs font-semibold px-2.5 py-1 rounded-full border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300';
      } else {
        supabasePill.textContent = 'Almacenamiento Local (Listo para Supabase)';
        supabasePill.className = 'text-xs font-semibold px-2.5 py-1 rounded-full border border-brand-border bg-brand-bg text-brand-muted';
      }
    }

    if (!isTeacher) {
      panelUnauthorized?.classList.remove('hidden');
      panelContent?.classList.add('hidden');
      if (roleBadge) {
        roleBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 border border-rose-300 dark:border-rose-800';
      }
      if (roleText) roleText.textContent = 'Sin permisos de docente';
      return;
    }

    panelUnauthorized?.classList.add('hidden');
    panelContent?.classList.remove('hidden');
    if (roleBadge) {
      roleBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800';
    }
    if (roleText) roleText.textContent = 'Modo Docente Habilitado';

    const db = getPortalDB();
    const inputSab = document.getElementById('week-sabado') as HTMLInputElement | null;
    const inputDom = document.getElementById('week-domingo') as HTMLInputElement | null;

    if (!skipInputSync) {
      if (inputSab && document.activeElement !== inputSab) {
        inputSab.value = String(db.grupos.sabado?.semanaActual || 4);
      }
      if (inputDom && document.activeElement !== inputDom) {
        inputDom.value = String(db.grupos.domingo?.semanaActual || 1);
      }
    }

    const sabWeek = parseInt(inputSab?.value || String(db.grupos.sabado?.semanaActual || 4), 10);
    const domWeek = parseInt(inputDom?.value || String(db.grupos.domingo?.semanaActual || 1), 10);
    renderGroupLessonPreview('panel-sabado-lesson-details', sabWeek);
    renderGroupLessonPreview('panel-domingo-lesson-details', domWeek);
    initQuickProjectDropdown();

    renderStudentsTable(db.usuarios.filter(u => u.rol === 'alumno'));
  }

  function renderStudentsTable(students: any[]) {
    const studentsTbody = document.getElementById('panel-students-tbody');
    if (!studentsTbody) return;
    if (students.length === 0) {
      studentsTbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-xs text-brand-muted">No hay alumnos registrados.</td></tr>`;
      return;
    }
    studentsTbody.innerHTML = students.map(st => `
      <tr class="hover:bg-brand-hover-bg/20 transition-colors">
        <td class="py-2.5 px-3 font-semibold text-brand-text">${escapeHtml(st.nombre)}</td>
        <td class="py-2.5 px-3">
          <code class="font-mono text-xs px-2 py-0.5 rounded bg-brand-border/40 text-brand-primary font-bold select-all">${escapeHtml(st.username || st.id)}</code>
        </td>
        <td class="py-2.5 px-3 text-center font-mono text-[11px] text-brand-muted">${escapeHtml(st.matricula || '—')}</td>
        <td class="py-2.5 px-3 text-center">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold ${st.grupo === 'sabado' ? 'bg-amber-500/10 text-amber-700 dark:text-amber-300' : 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300'}">
            ${st.grupo === 'sabado' ? 'Sábado' : 'Domingo'}
          </span>
        </td>
        <td class="py-2.5 px-3 text-right">
          <button
            type="button"
            data-copy-user="${escapeHtml(st.username || st.id)}"
            class="btn-copy-user px-2 py-1 rounded-md text-[11px] font-semibold border border-brand-border bg-white dark:bg-brand-sidebar-bg hover:border-brand-primary text-brand-text transition-all"
            title="Copiar usuario y contraseña provisional"
          >
            Copiar datos
          </button>
        </td>
      </tr>
    `).join('');

    studentsTbody.querySelectorAll<HTMLButtonElement>('.btn-copy-user').forEach(btn => {
      btn.addEventListener('click', () => {
        const userStr = btn.dataset.copyUser || '';
        const textToCopy = `Usuario: ${userStr}\nContraseña provisional: sabcpi`;
        navigator.clipboard.writeText(textToCopy).then(() => {
          const prevText = btn.textContent;
          btn.textContent = '¡Copiado!';
          btn.classList.add('text-emerald-600', 'border-emerald-500');
          setTimeout(() => {
            btn.textContent = prevText;
            btn.classList.remove('text-emerald-600', 'border-emerald-500');
          }, 2000);
        });
      });
    });
  }

  // Carga inicial sincronizada sin bucles de eventos
  async function initialSync() {
    initPanel();

    if (isSupabaseConfigured()) {
      // 1. Obtener las semanas de los grupos desde Supabase
      const groupsChanged = await syncRemoteGroups();
      if (groupsChanged) {
        initPanel();
      }

      // 2. Obtener lista de alumnos desde Supabase
      if (!isSyncingStudents) {
        isSyncingStudents = true;
        try {
          const remoteStudents = await fetchStudentsFromSupabase();
          if (remoteStudents && remoteStudents.length > 0) {
            const db = getPortalDB();
            const prof = db.usuarios.find(u => u.rol === 'profesor') || db.usuarios[0];
            db.usuarios = [prof, ...remoteStudents];
            // Guardar localmente de forma directa sin disparar cpi-portal-update recursivo
            savePortalDB(db);
            renderStudentsTable(remoteStudents);
          }
        } catch (err) {
          console.warn('Error al obtener alumnos remotos:', err);
        } finally {
          isSyncingStudents = false;
        }
      }
    }
  }

  // Escuchar cambios de escritura directa en inputs de semana
  document.getElementById('week-sabado')?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value || '1', 10) || 1;
    renderGroupLessonPreview('panel-sabado-lesson-details', val);
  });

  document.getElementById('week-domingo')?.addEventListener('input', (e) => {
    const val = parseInt((e.target as HTMLInputElement).value || '1', 10) || 1;
    renderGroupLessonPreview('panel-domingo-lesson-details', val);
  });

  // Eventos de fijar / avanzar semana
  document.getElementById('btn-save-sabado')?.addEventListener('click', () => {
    const input = document.getElementById('week-sabado') as HTMLInputElement | null;
    if (input) {
      const val = Math.max(1, Math.min(54, parseInt(input.value) || 1));
      input.value = String(val);
      updateWeek('sabado', val);
      renderGroupLessonPreview('panel-sabado-lesson-details', val);
      showFeedback('feedback-sabado', `✓ Semana ${val} guardada`);
    }
  });

  document.getElementById('btn-advance-sabado')?.addEventListener('click', () => {
    const input = document.getElementById('week-sabado') as HTMLInputElement | null;
    const current = parseInt(input?.value || '1') || 1;
    const nextVal = Math.min(54, current + 1);
    if (input) input.value = String(nextVal);
    updateWeek('sabado', nextVal);
    renderGroupLessonPreview('panel-sabado-lesson-details', nextVal);
    showFeedback('feedback-sabado', `✓ Semana ${nextVal} guardada`);
  });

  document.getElementById('btn-save-domingo')?.addEventListener('click', () => {
    const input = document.getElementById('week-domingo') as HTMLInputElement | null;
    if (input) {
      const val = Math.max(1, Math.min(54, parseInt(input.value) || 1));
      input.value = String(val);
      updateWeek('domingo', val);
      renderGroupLessonPreview('panel-domingo-lesson-details', val);
      showFeedback('feedback-domingo', `✓ Semana ${val} guardada`);
    }
  });

  document.getElementById('btn-advance-domingo')?.addEventListener('click', () => {
    const input = document.getElementById('week-domingo') as HTMLInputElement | null;
    const current = parseInt(input?.value || '1') || 1;
    const nextVal = Math.min(54, current + 1);
    if (input) input.value = String(nextVal);
    updateWeek('domingo', nextVal);
    renderGroupLessonPreview('panel-domingo-lesson-details', nextVal);
    showFeedback('feedback-domingo', `✓ Semana ${nextVal} guardada`);
  });

  // Botón proyector directo de clases
  document.getElementById('btn-quick-project-go')?.addEventListener('click', () => {
    const sel = document.getElementById('select-quick-project-lesson') as HTMLSelectElement | null;
    if (sel && sel.value) {
      window.location.href = `/${sel.value}?mode=slides`;
    }
  });

  // Exportar Respaldo
  document.getElementById('btn-export-json')?.addEventListener('click', () => {
    const data = exportDB();
    const blob = new Blob([data], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `cpi_respaldo_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Importar Respaldo
  document.getElementById('input-import-json')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = () => {
        if (typeof reader.result === 'string') {
          if (importDB(reader.result)) {
            alert('Datos importados exitosamente.');
            initPanel();
          } else {
            alert('Formato de archivo inválido.');
          }
        }
      };
      reader.readAsText(file);
    }
  });

  // Restablecer Semilla
  document.getElementById('btn-reset-data')?.addEventListener('click', () => {
    if (confirm('¿Restablecer toda la base a los datos iniciales?')) {
      savePortalDB(JSON.parse(JSON.stringify(SEED_PORTAL_DB)));
      initPanel();
      alert('Base restablecida con éxito.');
    }
  });

  initialSync();
  window.addEventListener('cpi-portal-update', () => initPanel(true));
</script>
