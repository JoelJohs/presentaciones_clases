---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavigationResult } from '../utils/navigation';
import { getNavigationStructure } from '../utils/navigation';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  nav?: NavigationResult;
  activeSlug?: string;
  isLesson?: boolean;
}

const { 
  title = 'Plataforma de Estudios', 
  nav: propsNav, 
  activeSlug = '',
  isLesson = false,
} = Astro.props;

let nav = propsNav;
if (!nav || !nav.modules || nav.modules.length === 0) {
  try {
    const lecciones = await getCollection('lecciones');
    nav = getNavigationStructure(lecciones);
  } catch (e) {
    nav = { initialPages: [], modules: [], extras: [], allLessonsOrdered: [] };
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Plataforma de lecciones y material de clases de tecnología e informática." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Plataforma de Estudios</title>

    <!-- Script inicial para evitar parpadeos de tema y vista -->
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

      if (localStorage.getItem('sidebar-collapsed') === 'true') {
        document.documentElement.classList.add('sidebar-collapsed');
      }

      // La plataforma opera de forma natural en modo de lectura con scroll continuo
      document.documentElement.classList.remove('presentation-mode', 'presentation-scroll-mode', 'presentation-slides-mode');
      document.documentElement.classList.add('reading-mode');

      try {
        const sessRaw = localStorage.getItem('cpi_portal_session_v1');
        const sess = sessRaw ? JSON.parse(sessRaw) : null;
        if (sess && sess.userId) {
          const dbRaw = localStorage.getItem('cpi_portal_db_v2') || localStorage.getItem('cpi_portal_db_v1');
          const db = dbRaw ? JSON.parse(dbRaw) : null;
          const user = db && db.usuarios ? db.usuarios.find(u => u.id === sess.userId) : null;
          if (user) {
            document.documentElement.dataset.authRole = user.rol;
          }
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-brand-bg text-brand-text min-h-screen antialiased flex flex-col selection:bg-brand-primary selection:text-white">
    <!-- Enlace de accesibilidad -->
    <a href="#main-content" class="skip-link">Saltar al contenido</a>

    <div class="flex-1 flex min-h-screen">
      <!-- Backdrop móvil -->
      <div id="sidebar-backdrop" class="fixed inset-0 z-30 bg-black/40 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none lg:hidden"></div>

      <!-- Barra lateral permanente de navegación -->
      <Sidebar nav={nav} activeSlug={activeSlug} />

      <!-- Contenedor principal con margen adaptativo -->
      <div id="main-content-wrapper" class="flex-1 flex flex-col min-h-screen lg:pl-72 transition-all duration-300">
        <Header isLesson={isLesson} />

        <main id="main-content" tabindex="-1" class={`flex-1 w-full ${isLesson ? 'max-w-7xl' : 'max-w-7xl'} mx-auto px-4 sm:px-8 py-8 transition-all`}>
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <!-- Script de interacción base -->
    <script>
      // 1. Alternador móvil
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');

      function toggleMobileSidebar(open: boolean) {
        if (!sidebar || !backdrop) return;
        menuToggle?.setAttribute('aria-expanded', String(open));
        if (open) {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          document.body.style.overflow = 'hidden';
        } else {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          backdrop.classList.remove('opacity-100');
          document.body.style.overflow = '';
        }
      }

      menuToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !sidebar?.classList.contains('-translate-x-full');
        toggleMobileSidebar(!isOpen);
      });

      backdrop?.addEventListener('click', () => toggleMobileSidebar(false));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebar && !sidebar.classList.contains('-translate-x-full')) {
          toggleMobileSidebar(false);
        }
      });

      // 2. Alternador de temario en escritorio (colapsar barra lateral)
      const sidebarToggle = document.getElementById('sidebar-toggle');
      sidebarToggle?.addEventListener('click', () => {
        document.documentElement.classList.toggle('sidebar-collapsed');
        localStorage.setItem('sidebar-collapsed', String(document.documentElement.classList.contains('sidebar-collapsed')));
      });

      // 3. Alternador de tema claro / oscuro
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('color-theme', isDark ? 'dark' : 'light');
      });

      // 4. Barra de progreso de lectura (scroll spy)
      const progressBar = document.getElementById('reading-progress-bar');
      if (progressBar) {
        const handleScroll = () => {
          const docEl = document.documentElement;
          const totalHeight = docEl.scrollHeight - window.innerHeight;
          if (totalHeight <= 0) {
            progressBar.style.width = '0%';
            return;
          }
          const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
          progressBar.style.width = `${progress}%`;
        };
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();
      }
    </script>

    <style is:global>
      @media (min-width: 1024px) {
        .sidebar-collapsed #sidebar {
          transform: translateX(-100%);
        }
        .sidebar-collapsed #main-content-wrapper {
          padding-left: 0 !important;
        }
      }
    </style>
  </body>
</html>
