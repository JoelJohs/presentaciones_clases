---
import { Icon } from 'astro-icon/components';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class={`border-t border-brand-border bg-white/70 dark:bg-brand-sidebar-bg/40 text-brand-muted text-xs transition-colors backdrop-blur-xs mt-auto ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-brand-border/60 pb-5">
      <!-- Identidad y propósito -->
      <div class="flex items-center gap-3">
        <div class="h-7 w-7 rounded-lg bg-brand-primary text-white flex items-center justify-center font-bold text-xs shadow-xs shrink-0">
          CPI
        </div>
        <div>
          <span class="font-bold text-brand-navy dark:text-slate-100 text-sm">
            Plataforma de Estudios CPI
          </span>
          <p class="text-xs text-brand-muted">
            Centro de Capacitación Práctica en Informática y Ofimática • Turnos de Fin de Semana
          </p>
        </div>
      </div>

      <!-- Atajos de Teclado del Taller -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-bold text-brand-navy dark:text-slate-200 mr-1 flex items-center gap-1">
          <Icon name="lucide:keyboard" class="w-3.5 h-3.5 text-brand-primary" />
          Atajos de Taller:
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-brand-border font-mono text-xs text-brand-text">
          <kbd class="font-bold">F</kbd> Pantalla completa
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-brand-border font-mono text-xs text-brand-text">
          <kbd class="font-bold">←</kbd> <kbd class="font-bold">→</kbd> Diapositivas
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-brand-border font-mono text-xs text-brand-text">
          <kbd class="font-bold">Espacio</kbd> Avanzar
        </span>
      </div>
    </div>

    <!-- Barra inferior de copyright y estado -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 pt-4 text-xs">
      <div class="flex items-center gap-2">
        <span>© {currentYear} CPI Capacitaciones. Evaluación 100% práctica basada en desempeño técnico.</span>
      </div>

      <div class="flex items-center gap-3 font-mono">
        <span class="inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Sistema Local Activo
        </span>
        <span class="text-brand-border">|</span>
        <span>Astro 6 + Tailwind 4</span>
      </div>
    </div>
  </div>
</footer>
