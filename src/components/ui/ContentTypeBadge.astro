---
import type { StudyPlanItemKind } from '../../features/progress';
import { Icon } from 'astro-icon/components';

interface Props {
  kind: StudyPlanItemKind;
  size?: 'sm' | 'md';
}

const { kind, size = 'sm' } = Astro.props;

const badgeConfig: Record<
  StudyPlanItemKind,
  { label: string; bg: string; text: string; border: string; icon: string }
> = {
  lesson: {
    label: 'Lección',
    bg: 'bg-teal-50 dark:bg-teal-950/40',
    text: 'text-teal-700 dark:text-teal-300',
    border: 'border-teal-200 dark:border-teal-800',
    icon: 'lucide:book-open',
  },
  review: {
    label: 'Repaso',
    bg: 'bg-amber-50 dark:bg-amber-950/40',
    text: 'text-amber-700 dark:text-amber-300',
    border: 'border-amber-200 dark:border-amber-800',
    icon: 'lucide:rotate-ccw',
  },
  activity: {
    label: 'Práctica',
    bg: 'bg-purple-50 dark:bg-purple-950/40',
    text: 'text-purple-700 dark:text-purple-300',
    border: 'border-purple-200 dark:border-purple-800',
    icon: 'lucide:wrench',
  },
  assessment: {
    label: 'Evaluación',
    bg: 'bg-rose-50 dark:bg-rose-950/40',
    text: 'text-rose-700 dark:text-rose-300',
    border: 'border-rose-200 dark:border-rose-800',
    icon: 'lucide:clipboard-pen-line',
  },
  topic: {
    label: 'Tema',
    bg: 'bg-indigo-50 dark:bg-indigo-950/40',
    text: 'text-indigo-700 dark:text-indigo-300',
    border: 'border-indigo-200 dark:border-indigo-800',
    icon: 'lucide:folder-open',
  },
  module: {
    label: 'Módulo',
    bg: 'bg-blue-50 dark:bg-blue-950/40',
    text: 'text-blue-700 dark:text-blue-300',
    border: 'border-blue-200 dark:border-blue-800',
    icon: 'lucide:package',
  },
  informational: {
    label: 'Recurso',
    bg: 'bg-stone-100 dark:bg-stone-800',
    text: 'text-stone-700 dark:text-stone-300',
    border: 'border-stone-200 dark:border-stone-700',
    icon: 'lucide:pin',
  },
};

const config = badgeConfig[kind] || badgeConfig.informational;
const sizeClasses = size === 'sm' ? 'px-2 py-0.5 text-[10px]' : 'px-2.5 py-1 text-xs';
---

<span
  class={`inline-flex items-center gap-1 rounded-full font-semibold border ${config.bg} ${config.text} ${config.border} ${sizeClasses}`}
>
  <Icon name={config.icon} class="h-3 w-3" aria-hidden="true" />
  <span>{config.label}</span>
</span>
