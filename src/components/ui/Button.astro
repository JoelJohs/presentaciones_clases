---
import { Icon } from 'astro-icon/components';

interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'download' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  icon,
  iconPosition = 'left',
  class: className = '',
  id,
  ...rest
} = Astro.props;

// Base classes
const baseStyles = 'inline-flex items-center justify-center font-semibold rounded-lg transition-all duration-150 select-none cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2';

// Variant classes
const variantStyles: Record<string, string> = {
  primary: 'bg-brand-primary hover:bg-brand-primary-hover text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-brand-primary',
  secondary: 'bg-slate-100 dark:bg-brand-sidebar-bg hover:bg-slate-200 dark:hover:bg-slate-800 text-brand-text hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-brand-border',
  outline: 'border border-brand-border hover:bg-brand-hover-bg text-brand-text hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-brand-primary',
  download: 'btn-download', // Consumes dedicated .btn-download from global.css
  ghost: 'text-brand-muted hover:text-brand-text hover:bg-brand-hover-bg focus-visible:outline-brand-primary',
  danger: 'bg-red-600 hover:bg-red-700 text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-red-500',
};

// Size classes (download variant handles its own padding)
const sizeStyles: Record<string, string> = {
  sm: 'text-xs px-2.5 py-1.5 gap-1.5',
  md: 'text-sm px-4 py-2 gap-2',
  lg: 'text-base px-5 py-2.5 gap-2.5',
};

const iconSizes: Record<string, string> = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-5 h-5',
};

const disabledStyles = disabled ? 'opacity-50 cursor-not-allowed pointer-events-none hover:translate-y-0 shadow-none' : '';

const finalClass = variant === 'download'
  ? `${variantStyles.download} ${disabledStyles} ${className}`
  : `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${disabledStyles} ${className}`;
---

{
  href && !disabled ? (
    <a href={href} class={finalClass} id={id} {...rest}>
      {icon && iconPosition === 'left' && <Icon name={icon} class={iconSizes[size]} />}
      <slot />
      {icon && iconPosition === 'right' && <Icon name={icon} class={iconSizes[size]} />}
    </a>
  ) : (
    <button type={type} disabled={disabled} class={finalClass} id={id} {...rest}>
      {icon && iconPosition === 'left' && <Icon name={icon} class={iconSizes[size]} />}
      <slot />
      {icon && iconPosition === 'right' && <Icon name={icon} class={iconSizes[size]} />}
    </button>
  )
}
