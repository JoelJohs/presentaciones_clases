---
import { Icon } from 'astro-icon/components';

interface Props {
  label?: string;
  id: string;
  name?: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'search' | 'tel' | 'url';
  placeholder?: string;
  value?: string;
  disabled?: boolean;
  required?: boolean;
  helperText?: string;
  error?: string;
  icon?: string;
  class?: string;
  [key: string]: any;
}

const {
  label,
  id,
  name = id,
  type = 'text',
  placeholder,
  value,
  disabled = false,
  required = false,
  helperText,
  error,
  icon,
  class: className = '',
  ...rest
} = Astro.props;

const helperId = helperText ? `${id}-helper` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [errorId, helperId].filter(Boolean).join(' ') || undefined;

const baseInput = 'w-full rounded-lg border bg-white dark:bg-[#101E2B] text-brand-text text-sm transition-colors duration-150 py-2 focus-visible:outline-2 focus-visible:outline-offset-1';
const paddingStyles = icon ? 'pl-9 pr-3' : 'px-3';
const borderStyles = error
  ? 'border-red-500 text-red-950 dark:text-red-200 focus-visible:outline-red-500 focus-visible:border-red-500'
  : 'border-brand-border focus-visible:outline-brand-primary focus-visible:border-brand-primary';
const disabledStyles = disabled
  ? 'opacity-50 cursor-not-allowed bg-slate-100 dark:bg-slate-900/50'
  : 'hover:border-brand-strong';

const finalInputClass = `${baseInput} ${paddingStyles} ${borderStyles} ${disabledStyles} ${className}`;
---

<div class="space-y-1.5 w-full">
  {label && (
    <label for={id} class="block text-xs font-semibold text-brand-navy dark:text-slate-200">
      {label} {required && <span class="text-red-500" aria-hidden="true">*</span>}
    </label>
  )}

  <div class="relative flex items-center">
    {icon && (
      <div class="absolute left-3 pointer-events-none text-brand-muted">
        <Icon name={icon} class="w-4 h-4" />
      </div>
    )}

    <input
      id={id}
      name={name}
      type={type}
      placeholder={placeholder}
      value={value}
      disabled={disabled}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class={finalInputClass}
      {...rest}
    />
  </div>

  {error && (
    <p id={errorId} class="text-xs text-red-600 dark:text-red-400 font-medium flex items-center gap-1">
      <Icon name="lucide:alert-circle" class="w-3.5 h-3.5 shrink-0" />
      <span>{error}</span>
    </p>
  )}

  {!error && helperText && (
    <p id={helperId} class="text-xs text-brand-muted">
      {helperText}
    </p>
  )}
</div>
