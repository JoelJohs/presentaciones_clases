---
export type LessonStatus = 'completed' | 'current' | 'available' | 'locked';

interface Props {
  status: LessonStatus;
}

const { status } = Astro.props;

const statusConfig: Record<
  LessonStatus,
  { label: string; bg: string; text: string; iconPath: string }
> = {
  completed: {
    label: 'Completada',
    bg: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
    text: 'text-emerald-700 dark:text-emerald-300',
    iconPath: 'M4.5 12.75l6 6 9-13.5',
  },
  current: {
    label: 'Siguiente',
    bg: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 animate-pulse',
    text: 'text-amber-700 dark:text-amber-300',
    iconPath: 'M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z',
  },
  available: {
    label: 'Disponible',
    bg: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
    text: 'text-slate-600 dark:text-slate-400',
    iconPath: 'M12 4.5v15m7.5-7.5h-15',
  },
  locked: {
    label: 'Próximamente',
    bg: 'bg-stone-100 text-stone-500 dark:bg-stone-900 dark:text-stone-500',
    text: 'text-stone-400 dark:text-stone-600',
    iconPath: 'M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z',
  },
};

const config = statusConfig[status] || statusConfig.available;
---

<span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium ${config.bg}`}>
  <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d={config.iconPath} />
  </svg>
  <span>{config.label}</span>
</span>
