---
import {
  translateLegacyId,
  getRelationByStudyPlanId,
  type StudyPlanItemKind,
} from '../features/progress';
import ContentTypeBadge from './ui/ContentTypeBadge.astro';

interface Subtema {
  nombre: string;
  descripcion: string;
  duracion: number;
}

interface Tema {
  titulo: string;
  subtemas: Subtema[];
}

interface Modulo {
  numero: number;
  titulo: string;
  color: string;
  semanas: number;
  progreso: number;
  temas: Tema[];
}

interface Props {
  modulos: Modulo[];
}

const { modulos } = Astro.props;

const totalSemanas = modulos.reduce(
  (sum, mod) => sum + mod.temas.reduce((s, t) => s + t.subtemas.length, 0),
  0,
);
---

<div id="plan-estudio">
  <div class="plan-global" id="plan-global">
    <div class="plan-global-row">
      <span class="plan-global-label">Progreso general</span>
      <span class="plan-global-count" id="plan-global-count">0/{totalSemanas}</span>
    </div>
    <div class="plan-global-bar">
      <div class="plan-global-fill" id="plan-global-fill" style="width:0%"></div>
    </div>
  </div>

  {
    modulos.map((mod) => (
      <div
        class="plan-modulo"
        style={`--c: ${mod.color}`}
        data-mod={mod.numero}
      >
        <button
          type="button"
          class="plan-row w-full text-left"
          aria-expanded="false"
          aria-controls={`plan-body-${mod.numero}`}
        >
          <span class="plan-num">{String(mod.numero).padStart(2, '0')}</span>
          <span class="plan-title">{mod.titulo}</span>
          <span class="plan-weeks" id={`plan-w-${mod.numero}`}>0/{mod.semanas}</span>
          <div class="plan-progress-wrap">
            <div class="plan-progress" id={`plan-p-${mod.numero}`} style="width:0%"></div>
          </div>
          <svg class="plan-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <div id={`plan-body-${mod.numero}`} class="plan-body hidden">
          <div class="plan-body-inner">
            {
              mod.temas.map((tema, ti) => (
                <div class="plan-tema">
                  <h3 class="plan-tema-title">
                    <span class="plan-dot" style={`background:${mod.color}`}></span>
                    {tema.titulo}
                  </h3>
                  <div class="plan-subtemas">
                    {tema.subtemas.map((st, si) => {
                      const legacyId = `m${mod.numero}-${ti + 1}-${si + 1}`;
                      const progressId = translateLegacyId(legacyId);
                      const rel = getRelationByStudyPlanId(progressId);
                      const kind: StudyPlanItemKind = rel?.kind ?? 'lesson';
                      const lessonSlug = rel?.lessonSlug ?? '';
                      return (
                        <div class="plan-subtema flex-wrap sm:flex-nowrap">
                          <input
                            type="checkbox"
                            id={legacyId}
                            class="plan-cb"
                            data-progress-id={progressId}
                            data-kind={kind}
                            data-lesson-slug={lessonSlug}
                          />
                          <div class="flex items-center gap-2 flex-wrap min-w-0">
                            <label for={legacyId} class="plan-st-name">{st.nombre}</label>
                            <ContentTypeBadge kind={kind} size="sm" />
                          </div>
                          <span class="plan-st-desc">{st.descripcion}</span>
                          <span class="plan-st-dur">{st.duracion} sem</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  import {
    initializeProgress,
    setLessonCompleted,
    subscribeToProgress,
    calculateStudyPlanMetrics,
    getLegacyNonCanonicalState,
    saveLegacyNonCanonicalState,
  } from '../features/progress';

  (function () {
    type ProgressState = Record<string, boolean>;
    const wrapper = document.getElementById('plan-estudio');
    if (!wrapper) return;

    function allCbs(): NodeListOf<HTMLInputElement> {
      if (!wrapper) return document.querySelectorAll<HTMLInputElement>('none');
      return wrapper.querySelectorAll<HTMLInputElement>('.plan-cb');
    }

    function syncCheckboxesFromStore(completedSlugs: string[]) {
      if (!wrapper) return;
      const cbs = allCbs();
      for (let i = 0; i < cbs.length; i++) {
        const cb = cbs[i];
        const kind = cb.getAttribute('data-kind');
        const slug = cb.getAttribute('data-lesson-slug');

        if (kind === 'lesson' && slug) {
          cb.checked = completedSlugs.includes(slug);
        }
      }
    }

    function loadNonCanonicalState() {
      if (!wrapper) return;
      try {
        const state = getLegacyNonCanonicalState();
        const cbs = allCbs();
        for (let i = 0; i < cbs.length; i++) {
          const cb = cbs[i];
          const kind = cb.getAttribute('data-kind');
          if (kind !== 'lesson' && cb.id && state[cb.id] === true) {
            cb.checked = true;
          }
        }
      } catch {}
    }

    function saveNonCanonicalState() {
      if (!wrapper) return;
      const state: ProgressState = {};
      const cbs = allCbs();
      for (let i = 0; i < cbs.length; i++) {
        const cb = cbs[i];
        const kind = cb.getAttribute('data-kind');
        if (kind !== 'lesson' && cb.id) {
          state[cb.id] = cb.checked;
        }
      }
      saveLegacyNonCanonicalState(state);
    }

    function updateMetrics() {
      if (!wrapper) return;
      const cbs = wrapper.querySelectorAll<HTMLInputElement>('.plan-cb[data-kind="lesson"]');
      const total = cbs.length;
      if (total === 0) return;

      const checked = wrapper.querySelectorAll<HTMLInputElement>('.plan-cb[data-kind="lesson"]:checked').length;
      const { percent, checkedCount, totalItems } = calculateStudyPlanMetrics(total, checked);

      const globalCount = document.getElementById('plan-global-count');
      const globalFill = document.getElementById('plan-global-fill');
      if (globalCount) globalCount.textContent = `${checkedCount}/${totalItems}`;
      if (globalFill) globalFill.style.width = `${percent}%`;

      const mods = wrapper.querySelectorAll<HTMLElement>('.plan-modulo');
      for (let i = 0; i < mods.length; i++) {
        const mod = mods[i];
        const num = mod.getAttribute('data-mod');
        const modLessonCbs = mod.querySelectorAll<HTMLInputElement>('.plan-cb[data-kind="lesson"]');
        const totalMod = modLessonCbs.length > 0 ? modLessonCbs.length : mod.querySelectorAll<HTMLInputElement>('.plan-cb').length;
        const checkedMod = modLessonCbs.length > 0
          ? mod.querySelectorAll<HTMLInputElement>('.plan-cb[data-kind="lesson"]:checked').length
          : mod.querySelectorAll<HTMLInputElement>('.plan-cb:checked').length;

        const { percent: pctMod, checkedCount: checkedCountMod, totalItems: totalModItems } = calculateStudyPlanMetrics(totalMod, checkedMod);

        const wEl = document.getElementById(`plan-w-${num}`);
        const pEl = document.getElementById(`plan-p-${num}`);
        if (wEl) wEl.textContent = `${checkedCountMod}/${totalModItems}`;
        if (pEl) pEl.style.width = `${pctMod}%`;
      }
    }

    const canonicalCompleted = initializeProgress();
    loadNonCanonicalState();
    syncCheckboxesFromStore(canonicalCompleted);
    updateMetrics();

    subscribeToProgress((state) => {
      syncCheckboxesFromStore(state);
      updateMetrics();
    });

    wrapper.addEventListener('change', function (e: Event) {
      const target = e.target;
      if (target instanceof HTMLInputElement && target.classList.contains('plan-cb')) {
        const kind = target.getAttribute('data-kind');
        const slug = target.getAttribute('data-lesson-slug');

        if (kind === 'lesson' && slug) {
          setLessonCompleted(slug, target.checked);
        } else {
          saveNonCanonicalState();
        }
        updateMetrics();
      }
    });

    wrapper.addEventListener('click', function (e: MouseEvent) {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const row = target.closest<HTMLElement>('.plan-row');
      if (!row) return;
      if (target.closest('.plan-cb, label')) return;

      const modulo = row.closest<HTMLElement>('.plan-modulo');
      if (!modulo) return;

      const isOpen = row.getAttribute('aria-expanded') === 'true';
      const body = modulo.querySelector<HTMLElement>('.plan-body');
      const chevron = row.querySelector<HTMLElement>('.plan-chevron');

      if (!wrapper) return;
      wrapper.querySelectorAll<HTMLElement>('.plan-row[aria-expanded="true"]').forEach(function (r) {
        if (r !== row) {
          r.setAttribute('aria-expanded', 'false');
          const b = r.closest('.plan-modulo')?.querySelector<HTMLElement>('.plan-body');
          if (b) b.classList.add('hidden');
          const ch = r.closest('.plan-modulo')?.querySelector<HTMLElement>('.plan-chevron');
          if (ch) ch.classList.remove('open');
        }
      });

      if (isOpen) {
        row.setAttribute('aria-expanded', 'false');
        body?.classList.add('hidden');
        chevron?.classList.remove('open');
      } else {
        row.setAttribute('aria-expanded', 'true');
        body?.classList.remove('hidden');
        chevron?.classList.add('open');
      }
    });

  })();
</script>

<style>
  #plan-estudio {
    font-family: var(--font-sans, 'Inter', system-ui, sans-serif);
  }

  .plan-global {
    padding: 12px 0 16px;
    margin-bottom: 4px;
    border-bottom: 2px solid var(--color-brand-border);
  }

  .plan-global-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .plan-global-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-brand-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .plan-global-count {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  .plan-global-bar {
    height: 6px;
    background: var(--color-brand-border);
    border-radius: 3px;
    overflow: hidden;
  }

  .plan-global-fill {
    height: 100%;
    background: var(--color-brand-primary);
    border-radius: 3px;
    transition: width 0.3s;
  }

  .plan-modulo {
    border-bottom: 1px solid var(--color-brand-border);
  }

  .plan-modulo:first-child {
    border-top: 1px solid var(--color-brand-border);
  }

  .plan-row {
    display: grid;
    grid-template-columns: 40px 1fr auto 80px 24px;
    align-items: center;
    gap: 12px;
    padding: 12px 8px 12px 0;
    cursor: pointer;
    user-select: none;
    background: transparent;
    border: 0;
    transition: background-color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .plan-row:hover {
      background: var(--color-brand-hover-bg);
    }
  }

  .plan-row:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: -2px;
  }

  .plan-num {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 14px;
    font-weight: 700;
    color: var(--c);
    text-align: right;
    line-height: 1;
  }

  .plan-title {
    font-family: var(--font-display, 'Outfit', sans-serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-brand-text);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .plan-weeks {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    color: var(--color-brand-muted);
    white-space: nowrap;
    text-align: right;
  }

  .plan-progress-wrap {
    height: 4px;
    background: var(--color-brand-border);
    border-radius: 2px;
    overflow: hidden;
  }

  .plan-progress {
    height: 100%;
    background: var(--c);
    border-radius: 2px;
    transition: width 0.3s;
  }

  .plan-chevron {
    width: 14px;
    height: 14px;
    color: var(--color-brand-muted);
    transition: transform 0.2s;
    justify-self: center;
  }

  .plan-chevron.open {
    transform: rotate(90deg);
  }

  .plan-body {
    border-top: 1px solid var(--color-brand-border);
  }

  .plan-body-inner {
    padding: 0 0 16px 52px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .plan-tema-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-brand-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 8px 0;
    padding: 0;
    border: 0;
  }

  .plan-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .plan-subtemas {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .plan-subtema {
    display: grid;
    grid-template-columns: auto 240px 1fr auto;
    gap: 10px;
    align-items: baseline;
    padding: 4px 0;
  }

  .plan-cb {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--color-brand-border);
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
    align-self: center;
    margin: 0;
    transition: border-color 0.15s, background 0.15s;
  }

  .plan-cb:hover {
    border-color: var(--c, var(--color-brand-primary));
  }

  .plan-cb:checked {
    background: var(--c, var(--color-brand-primary));
    border-color: var(--c, var(--color-brand-primary));
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3E%3C/svg%3E");
    background-size: 12px;
    background-position: center;
    background-repeat: no-repeat;
  }

  .plan-cb:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 1px;
  }

  .plan-st-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-brand-text);
    line-height: 1.4;
    cursor: pointer;
  }

  .plan-cb:checked + div .plan-st-name {
    text-decoration: line-through;
    text-decoration-color: var(--color-brand-muted);
    opacity: 0.6;
  }

  .plan-st-desc {
    font-size: 13px;
    color: var(--color-brand-muted);
    line-height: 1.4;
    min-width: 0;
  }

  .plan-st-dur {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    color: var(--color-brand-muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .plan-row {
      grid-template-columns: 32px 1fr auto 20px;
      gap: 8px;
      padding: 10px 0;
    }

    .plan-progress-wrap {
      display: none;
    }

    .plan-title {
      font-size: 13px;
    }

    .plan-num {
      font-size: 12px;
    }

    .plan-body-inner {
      padding: 0 0 12px 36px;
      gap: 12px;
    }

    .plan-subtema {
      grid-template-columns: auto 1fr auto;
      gap: 6px;
    }

    .plan-st-desc {
      display: none;
    }

    .plan-st-name {
      font-size: 13px;
    }
  }
</style>
