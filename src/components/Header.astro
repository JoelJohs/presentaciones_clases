---
import { Icon } from 'astro-icon/components';
import AuthSwitcher from './portal/AuthSwitcher.astro';

interface Props {
  isLesson?: boolean;
}

const { isLesson = false } = Astro.props;
---

<header class="sticky top-0 z-20 flex h-14 w-full items-center justify-between border-b border-brand-border bg-brand-bg/95 px-3 sm:px-5 backdrop-blur-xs transition-colors">
  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Botón móvil para abrir menú lateral -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-brand-muted hover:bg-brand-hover-bg hover:text-brand-text lg:hidden transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-brand-primary"
      aria-label="Abrir Menú Lateral"
      aria-controls="sidebar"
      aria-expanded="false"
    >
      <Icon name="lucide:menu" class="h-5 w-5" />
    </button>

    <!-- Botón escritorio para colapsar/expandir barra lateral -->
    <button
      id="sidebar-toggle"
      type="button"
      class="hidden lg:inline-flex h-9 w-9 items-center justify-center rounded-lg text-brand-muted hover:bg-brand-hover-bg hover:text-brand-text transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-brand-primary"
      aria-label="Alternar Temario"
      title="Alternar Temario / Barra Lateral"
    >
      <Icon name="lucide:panel-left" class="h-4 w-4" />
    </button>

    <!-- Logo / Nombre de plataforma -->
    <a href="/" class="flex items-center gap-2.5 font-semibold text-brand-navy dark:text-white text-sm sm:text-base tracking-tight hover:opacity-90 transition-opacity">
      <div class="h-7 w-7 rounded-md bg-brand-primary text-white flex items-center justify-center font-bold text-xs">
        CPI
      </div>
      <span class="hidden sm:inline font-bold">Plataforma de Estudios</span>
    </a>
  </div>

  <div class="flex items-center gap-2">
    <!-- Alternador de Tema Claro / Oscuro -->
    <button
      id="theme-toggle"
      type="button"
      class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-brand-border text-brand-muted hover:bg-brand-hover-bg hover:text-brand-text transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-brand-primary"
      aria-label="Cambiar tema claro u oscuro"
      title="Cambiar tema claro u oscuro"
    >
      <Icon name="lucide:sun" class="h-4 w-4 block dark:hidden" />
      <Icon name="lucide:moon" class="h-4 w-4 hidden dark:block" />
    </button>

    <!-- Componente de Sesión y Logout -->
    <AuthSwitcher />
  </div>

  {isLesson && (
    <!-- Barra sutil de progreso de lectura (0% a 100%) -->
    <div
      id="reading-progress-bar"
      class="absolute bottom-0 left-0 h-[2px] w-0 bg-brand-primary transition-[width] duration-75 ease-out"
      aria-hidden="true"
    ></div>
  )}
</header>
