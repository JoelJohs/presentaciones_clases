---
import type { NavigationResult } from '../utils/navigation';
import { Icon } from 'astro-icon/components';
import {
  CURRICULUM_MODULES,
  TOTAL_CURRICULUM_LESSONS,
} from '../config/curriculum';

interface Props {
  nav: NavigationResult;
}

const { nav } = Astro.props;

function moduleNumber(title: string): number {
  const match = title.match(/^(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
}

const processedModules = nav.modules.map(mod => {
  const modNum = moduleNumber(mod.title);
  const curMod = CURRICULUM_MODULES.find(m => m.number === modNum);

  return {
    title: mod.title,
    badge: modNum,
    shortTitle: curMod?.shortTitle || mod.title,
    icon: curMod?.icon || 'lucide:book-open',
    lessons: mod.topics.flatMap(t => t.lessons).map(l => {
      const curLesson = curMod?.topics.flatMap(tp => tp.lessons).find(cl => l.slug.endsWith(cl.id));
      return {
        slug: l.slug,
        title: l.title,
        isRepaso: l.slug.endsWith('/repaso'),
        kind: curLesson?.kind || 'lesson',
        duration: curLesson?.duration || 45,
      };
    }),
  };
});

const allLessonsData = processedModules.flatMap(m =>
  m.lessons.map(l => ({
    slug: l.slug,
    title: l.title,
    isRepaso: l.isRepaso,
    kind: l.kind,
  }))
);

const dashboardData = JSON.stringify({
  modules: processedModules,
  lessons: allLessonsData,
  totalCurriculumLessons: TOTAL_CURRICULUM_LESSONS,
});
---

<div id="dashboard-data" class="hidden">{dashboardData}</div>

<div x-data="dashboard" class="space-y-5">
  <!-- Tarjeta de Bienvenida y Avance Curricular -->
  <div class="rounded-2xl border border-brand-border bg-white dark:bg-brand-sidebar-bg p-5 sm:p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
      <div class="space-y-1">
        <h2 class="font-display font-bold text-base sm:text-lg text-brand-navy dark:text-white flex items-center gap-2">
          <Icon name="lucide:graduation-cap" class="h-5 w-5 text-brand-primary" aria-hidden="true" />
          <span>Panel de Avance Curricular</span>
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted">
          Plan formativo de 12 módulos de tecnología. Tu progreso de estudio se guarda automáticamente en este dispositivo.
        </p>
      </div>

      <div class="text-left sm:text-right shrink-0">
        <span class="text-xs font-semibold text-brand-muted block">Completadas</span>
        <span class="text-base font-mono font-bold text-brand-primary">
          <span x-text="completedCount">0</span> / <span x-text="totalCount">0</span>
        </span>
      </div>
    </div>

    <!-- Barra de progreso Global -->
    <div>
      <div class="flex items-center justify-between text-xs mb-1.5">
        <span class="font-medium text-brand-muted">Porcentaje del programa</span>
        <span class="font-bold font-mono text-brand-primary" x-text="percent + '%'">0%</span>
      </div>
      <div class="h-2.5 rounded-full bg-brand-border/80 dark:bg-brand-border overflow-hidden">
        <div class="h-full rounded-full bg-brand-primary transition-all duration-500" :style="'width:' + percent + '%'"></div>
      </div>
    </div>
  </div>

  <!-- Estado 1: Sin progreso (0%) -->
  <template x-if="completedCount === 0 && totalCount > 0">
    <div class="rounded-2xl border border-brand-primary/40 bg-brand-callout-bg dark:bg-brand-sidebar-bg p-6 text-center space-y-3 shadow-xs">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-primary/10 text-brand-primary font-bold text-xl">
        <Icon name="lucide:book-open" class="h-6 w-6" aria-hidden="true" />
      </div>
      <h3 class="text-base font-bold text-brand-navy dark:text-white">¡Bienvenido a tu plataforma de estudio!</h3>
      <p class="text-xs sm:text-sm text-brand-muted max-w-md mx-auto">
        Comienza con las lecciones introductorias para registrar tu avance en el temario.
      </p>
      <template x-if="nextLesson">
        <a :href="'/' + nextLesson.slug" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-primary text-white text-xs font-bold hover:bg-brand-accent transition-all shadow-xs">
          <span>Abrir primera lección</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </template>
    </div>
  </template>

  <!-- Estado 2: En progreso (Continuar) -->
  <template x-if="completedCount > 0 && nextLesson">
    <a :href="'/' + nextLesson.slug"
       class="flex items-center justify-between gap-4 rounded-2xl border border-brand-primary/40 bg-brand-callout-bg dark:bg-brand-hover-bg p-5 hover:border-brand-primary hover:shadow-xs transition-all duration-200 group min-h-[72px]">
      <div class="min-w-0">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span>
          Siguiente lección recomendada
        </span>
        <p class="text-sm sm:text-base font-bold text-brand-navy dark:text-white mt-1 truncate" x-text="nextLesson.title"></p>
      </div>
      <div class="flex items-center gap-2 text-brand-primary shrink-0">
        <span class="text-xs font-bold hidden sm:inline">Continuar</span>
        <svg class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </div>
    </a>
  </template>

  <!-- Barra interactiva de Búsqueda y Filtros -->
  <template x-if="totalCount > 1">
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative w-full sm:flex-1">
        <Icon name="lucide:search" class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-brand-muted pointer-events-none" />
        <input
          type="text"
          x-model="searchQuery"
          placeholder="Filtrar por tema o título de lección..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-brand-border bg-white dark:bg-brand-sidebar-bg text-xs sm:text-sm text-brand-navy dark:text-white placeholder:text-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-primary/30 transition-all"
        />
      </div>

      <!-- Filtros de Estado -->
      <div class="flex items-center gap-1 bg-slate-100 dark:bg-brand-sidebar-bg p-1 rounded-xl border border-brand-border w-full sm:w-auto justify-center">
        <button
          type="button"
          @click="activeFilter = 'all'"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer"
          :class="activeFilter === 'all' ? 'bg-white dark:bg-brand-bg text-brand-primary shadow-xs font-bold' : 'text-brand-muted hover:text-brand-text'"
        >
          Todas
        </button>
        <button
          type="button"
          @click="activeFilter = 'pending'"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer"
          :class="activeFilter === 'pending' ? 'bg-white dark:bg-brand-bg text-brand-primary shadow-xs font-bold' : 'text-brand-muted hover:text-brand-text'"
        >
          Pendientes
        </button>
        <button
          type="button"
          @click="activeFilter = 'completed'"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer"
          :class="activeFilter === 'completed' ? 'bg-white dark:bg-brand-bg text-brand-primary shadow-xs font-bold' : 'text-brand-muted hover:text-brand-text'"
        >
          Completadas
        </button>
      </div>
    </div>
  </template>

  <!-- Lista de Módulos Curriculares -->
  <div class="space-y-3">
    <template x-for="(mod, i) in filteredModules" :key="mod.title">
      <details class="group rounded-2xl border border-brand-border bg-white dark:bg-brand-sidebar-bg overflow-hidden shadow-xs" :open="modDone(mod) < modTotal(mod) || searchQuery.length > 0">
        <summary class="list-none flex items-center gap-3.5 p-4 sm:p-5 cursor-pointer select-none hover:bg-brand-hover-bg/30 transition-colors">
          <span class="module-badge shrink-0" :class="'module-badge-m' + Math.min(mod.badge || (i + 1), 12)" x-text="mod.badge"></span>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm sm:text-base font-bold text-brand-navy dark:text-white truncate" x-text="mod.title"></h3>
            <span class="text-xs text-brand-muted truncate block" x-text="mod.shortTitle"></span>
          </div>
          <span class="text-xs font-mono font-semibold shrink-0" :class="modAllDone(mod) ? 'text-brand-primary font-bold' : 'text-brand-muted'" x-text="modDone(mod) + '/' + modTotal(mod)"></span>
          <svg class="h-4 w-4 shrink-0 text-brand-muted transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="border-t border-brand-border divide-y divide-brand-border">
          <template x-for="lesson in mod.lessons" :key="lesson.slug">
            <div
              class="flex items-center gap-3 px-4 sm:px-5 py-3 hover:bg-brand-hover-bg/30 transition-colors"
              x-show="matchesFilter(lesson)"
            >
              <input type="checkbox"
                     :checked="done(lesson.slug)"
                     @change="toggle(lesson.slug)"
                     aria-label="Marcar lección completada"
                     class="h-5 w-5 shrink-0 rounded border-brand-border text-brand-primary focus:ring-brand-primary cursor-pointer dark:bg-brand-sidebar-bg dark:checked:bg-brand-primary">
              <a :href="'/' + lesson.slug"
                 class="flex-1 text-xs sm:text-sm min-w-0 flex items-center gap-2"
                 :class="done(lesson.slug) ? 'line-through opacity-60 text-brand-muted' : 'text-brand-text hover:text-brand-primary font-medium'">
                <template x-if="lesson.isRepaso">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800 shrink-0">Repaso</span>
                </template>
                <template x-if="lesson.kind === 'project'">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 shrink-0">Proyecto</span>
                </template>
                <template x-if="lesson.kind === 'assessment'">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800 shrink-0">Evaluación</span>
                </template>
                <span x-text="lesson.title" class="truncate"></span>
              </a>

              <a :href="'/' + lesson.slug" aria-label="Abrir lección" class="shrink-0 text-brand-muted hover:text-brand-primary transition-colors p-1.5 rounded-lg hover:bg-brand-hover-bg">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </div>
          </template>

          <!-- Módulo completado -->
          <template x-if="modDone(mod) === modTotal(mod) && modTotal(mod) > 0">
            <div class="px-4 py-3 text-center bg-emerald-50/50 dark:bg-emerald-950/20">
              <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 flex items-center justify-center gap-1.5">
                <Icon name="lucide:check-circle-2" class="h-4 w-4 text-emerald-600" />
                <span>Módulo completado</span>
              </span>
            </div>
          </template>
        </div>
      </details>
    </template>
  </div>
</div>

<script>
  import Alpine from 'alpinejs';
  import {
    initializeProgress,
    toggleLessonCompleted,
    subscribeToProgress,
    calculateDashboardProgress,
  } from '../features/progress';

  interface DashboardLesson {
    slug: string;
    title: string;
    isRepaso?: boolean;
    kind?: string;
  }

  interface DashboardModule {
    title: string;
    badge: number;
    shortTitle: string;
    lessons: DashboardLesson[];
  }

  Alpine.data('dashboard', () => ({
    completed: [] as string[],
    modules: [] as DashboardModule[],
    lessons: [] as DashboardLesson[],
    percent: 0,
    completedCount: 0,
    totalCount: 0,
    nextLesson: null as DashboardLesson | null,
    searchQuery: '',
    activeFilter: 'all',

    init() {
      const dataEl = document.getElementById('dashboard-data');
      const dataText = dataEl?.textContent ?? '{}';
      const data = JSON.parse(dataText);
      this.modules = data.modules ?? [];
      this.lessons = data.lessons ?? [];
      this.totalCount = this.lessons.length;

      this.completed = initializeProgress();
      this.recalc();

      subscribeToProgress((state) => {
        this.completed = state;
        this.recalc();
      });
    },

    get filteredModules(): DashboardModule[] {
      if (!this.searchQuery) return this.modules;
      const q = this.searchQuery.toLowerCase().trim();
      return this.modules.filter(mod => {
        const matchesModule = mod.title.toLowerCase().includes(q) || mod.shortTitle.toLowerCase().includes(q);
        const matchesAnyLesson = mod.lessons.some(l => l.title.toLowerCase().includes(q));
        return matchesModule || matchesAnyLesson;
      });
    },

    matchesFilter(lesson: DashboardLesson): boolean {
      if (this.searchQuery) {
        const q = this.searchQuery.toLowerCase().trim();
        if (!lesson.title.toLowerCase().includes(q)) return false;
      }
      if (this.activeFilter === 'completed') return this.done(lesson.slug);
      if (this.activeFilter === 'pending') return !this.done(lesson.slug);
      return true;
    },

    done(slug: string): boolean {
      return this.completed.indexOf(slug) !== -1;
    },

    toggle(slug: string) {
      this.completed = toggleLessonCompleted(slug);
      this.recalc();
    },

    recalc() {
      const validCompleted = this.lessons
        .map((l) => l.slug)
        .filter((slug) => this.done(slug));

      const { percent, completedCount } = calculateDashboardProgress(validCompleted, this.totalCount);
      this.completedCount = completedCount;
      this.percent = percent;

      this.nextLesson = null;
      for (let j = 0; j < this.lessons.length; j++) {
        if (!this.done(this.lessons[j].slug)) {
          this.nextLesson = this.lessons[j];
          break;
        }
      }
    },

    modDone(mod: DashboardModule): number {
      let count = 0;
      for (let i = 0; i < mod.lessons.length; i++) {
        if (this.done(mod.lessons[i].slug)) count++;
      }
      return count;
    },

    modTotal(mod: DashboardModule): number {
      return mod.lessons.length;
    },

    modAllDone(mod: DashboardModule): boolean {
      return this.modDone(mod) === this.modTotal(mod);
    },
  }));

  declare global {
    interface Window {
      Alpine?: typeof Alpine;
    }
  }

  if (!window.Alpine) {
    window.Alpine = Alpine;
    Alpine.start();
  }
</script>
